#!/usr/bin/env python3
"""
mkwasm2c-module — Compile a .wasm binary to a udynlink loadable .bin module.

This script wraps the wasm2c + mkmodule pipeline:
  1. Runs wasm2c on the input .wasm
  2. Patches the generated .c for bare-metal (NDEBUG, builtin string ops)
  3. Inspects the module for memory usage and export signatures
  4. Writes wasm_rt_config.h (per-module build configuration), a setup shim
     and export wrappers
  5. Compiles everything with mkmodule

Build configuration (--memory static|dynamic|external, --custom-page-size,
--stack-depth-limit, --trap-handler, --malloc/--free) lands in a generated
wasm_rt_config.h that reaches every translation unit via wasm-rt.h, not
just the shim.
"""

import argparse
import os
import re
import shutil
import subprocess
import sys
import tempfile

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import codegen_common as cc  # noqa: E402

import targets
from udynlink_utils import error, warn, debug, split_fname  # noqa: E402

REPO_ROOT = cc.REPO_ROOT

# ---------------------------------------------------------------------------
# Runtime source paths (relative to repo root)
# ---------------------------------------------------------------------------
RUNTIME_DIR = os.path.join(REPO_ROOT, "udynlink", "wasm2c_runtime")
RUNTIME_C = os.path.join(RUNTIME_DIR, "wasm-rt-udynlink.c")
RUNTIME_H = os.path.join(RUNTIME_DIR, "wasm-rt.h")

TOOLS_DIR = os.path.join(REPO_ROOT, "tools")
TESTED_WABT_VERSION = (1, 0, 34)


def find_wasm2c():
    """Resolve wasm2c: UDYNLINK_WASM2C env var, then the pinned wabt install
    (just setup-wabt), then PATH."""
    return cc.find_tool(None, "UDYNLINK_WASM2C",
                        [os.path.join(TOOLS_DIR, "wabt", "bin", "wasm2c"),
                         "wasm2c"],
                        "wasm2c not found; install wabt or run 'just setup-wabt'")


def check_wasm2c_version(wasm2c):
    """wasm2c's emitted code shape is load-bearing for this script's parsers;
    warn when the toolchain is older than the tested minimum."""
    try:
        res = subprocess.run([wasm2c, "--version"], capture_output=True,
                             text=True, timeout=15)
    except (OSError, subprocess.TimeoutExpired) as e:
        error("cannot run %s: %s" % (wasm2c, e))
    m = re.search(r"(\d+)\.(\d+)\.(\d+)", res.stdout)
    if not m:
        warn("unrecognized wasm2c version output: %r" % res.stdout.strip())
        return
    ver = tuple(int(g) for g in m.groups())
    if ver < TESTED_WABT_VERSION:
        warn("wasm2c %d.%d.%d is older than the tested minimum %d.%d.%d; "
             "generated-code parsing may misbehave (run 'just setup-wabt')"
             % (ver + TESTED_WABT_VERSION))


def resolve_memory_mode(args, mem_info):
    """Pick the linear-memory model.  auto: static for fixed-size memories,
    dynamic when the module grows its memory."""
    mode = args.memory
    if not mem_info["has_memory"]:
        if mode != "auto":
            warn("module has no linear memory; --memory=%s has no effect" % mode)
        return "none"
    if mode == "auto":
        return "dynamic" if mem_info["has_grow"] else "static"
    if mode == "static" and mem_info["has_grow"]:
        warn("module uses memory.grow; static memory cannot grow "
             "(memory.grow will return -1 at runtime)")
    return mode


def generate_config_header(config_path, memory_mode, mem_info, args):
    """Write wasm_rt_config.h so the per-module settings reach every TU that
    includes wasm-rt.h (runtime, generated code, shim) — not just the shim."""
    lines = [
        "/* wasm_rt_config.h — generated by mkwasm2c-module; do not edit.",
        " *",
        " * Included by wasm-rt.h via __has_include, so these settings reach",
        " * every translation unit of the module.",
        " */",
        "#ifndef WASM_RT_CONFIG_H_",
        "#define WASM_RT_CONFIG_H_",
        "",
    ]
    if memory_mode == "static":
        lines += [
            "#define WASM_RT_STATIC_MEMORY",
            "#define WASM_RT_INITIAL_PAGES %d" % mem_info["initial_pages"],
        ]
    elif memory_mode == "external":
        lines.append("#define WASM_RT_EXTERNAL_MEMORY")
    if args.custom_page_size:
        if mem_info["is64"]:
            warn("memory64 module: --custom-page-size ignored (page size is fixed at 2^48)")
        elif mem_info["has_memory"]:
            lines.append("#define WASM_RT_PAGE_SIZE %d" % args.custom_page_size)
    if args.trap_handler:
        lines += [
            "/* Host-provided trap handler, resolved at module load time.",
            " * The module does not define it. */",
            "#define WASM_RT_TRAP_HANDLER %s" % args.trap_handler,
        ]
    if args.stack_depth_limit is not None:
        lines += [
            "#define WASM_RT_USE_STACK_DEPTH_COUNT 1",
            "#define WASM_RT_MAX_CALL_STACK_DEPTH %d" % args.stack_depth_limit,
        ]
    if args.recoverable_traps or args.wrappers_recover:
        lines += [
            "/* Recoverable traps: wasm_rt_trap() longjmps to the one-shot",
            " * recovery point registered via wasm_rt_set_recovery() (host-side,",
            " * or baked into the export wrappers with --wrappers-recover)",
            " * instead of halting.  longjmp is resolved from the host at load. */",
            "#define WASM_RT_ENABLE_RECOVERY",
        ]
    lines += ["", "#endif /* WASM_RT_CONFIG_H_ */"]
    with open(config_path, "w") as f:
        f.write("\n".join(lines) + "\n")


# wasm2c-generated code needs these at -O2+ for spec conformance (sNaN->qNaN
# conversion, infinite recursion must trap); see wasm2c README "Compiling the
# wasm2c output".  Appended before user --build-flags so the user can override
# toggle-style with last-wins semantics.
WASM2C_CONFORMANCE_FLAGS = "-fno-optimize-sibling-calls -frounding-math -fsignaling-nans"

# ---------------------------------------------------------------------------
# Patch wasm2c-generated .c for bare-metal
# ---------------------------------------------------------------------------

def patch_wasm2c_generated(c_path, args):
    """Patch a wasm2c-generated .c file for bare-metal udynlink compilation."""
    with open(c_path, "r") as f:
        text = f.read()

    # Insert #define NDEBUG at the very top to neutralise assert() calls
    if not text.startswith("#define NDEBUG"):
        text = "#define NDEBUG\n" + text

    # Replace heavy string.h includes with builtin mappings so we don't pull
    # in libc object code.  wasm2c only uses memcpy, memset, memmove, memcmp.
    text = re.sub(
        r'#include\s+<string\.h>',
        '/* bare-metal: string.h replaced by builtins */\n'
        '#define memset __builtin_memset\n'
        '#define memcpy __builtin_memcpy\n'
        '#define memmove __builtin_memmove\n'
        '#define memcmp __builtin_memcmp',
        text
    )

    # math.h is kept; unused float helper functions are stripped by --gc-sections.
    # If the user knows the module is integer-only they can pass --build-flags
    # to add -DNO_MATH_H or similar, but we leave it alone by default.

    with open(c_path, "w") as f:
        f.write(text)

    if not args.no_verbose:
        print("Patched %s for bare-metal build." % c_path)

# ---------------------------------------------------------------------------
# Inspect generated code for memory usage
# ---------------------------------------------------------------------------

def inspect_memory_usage(c_path):
    """Scan the generated .c for wasm_rt_allocate_memory calls and memory.grow."""
    with open(c_path, "r") as f:
        text = f.read()

    has_grow = "wasm_rt_grow_memory" in text

    # Look for: wasm_rt_allocate_memory(&instance->..., initial, max, is64)
    m = re.search(
        r'wasm_rt_allocate_memory\s*\(\s*&[^,]+,\s*(\d+),\s*(\d+),\s*(\d+)\s*\)',
        text
    )
    if m:
        initial_pages = int(m.group(1))
        max_pages = int(m.group(2))
        is64 = bool(int(m.group(3)))
    else:
        initial_pages = 0
        max_pages = 0
        is64 = False

    return {
        "has_memory": m is not None,
        "has_grow": has_grow,
        "initial_pages": initial_pages,
        "max_pages": max_pages,
        "is64": is64,
    }

# ---------------------------------------------------------------------------
# Parse exports from generated header
# ---------------------------------------------------------------------------

def parse_exports(h_path):
    """Extract export signatures from the generated header.

    Returns a list of dicts:
      { 'wasm_name': 'add', 'c_name': 'w2c_add_add',
        'ret': 'u32', 'params': ['w2c_add*', 'u32', 'u32'] }

    Return types may be pointers (exported memory and globals are getters).
    Exports the wrapper generator cannot express (multi-result/sret:
    pointer parameters beyond the instance pointer) are a loud build error,
    never a silently missing export.
    """
    with open(h_path, "r") as f:
        text = f.read()

    exports = []
    matched_spans = []
    for m in EXPORT_DECL_RE.finditer(text):
        ret = " ".join(m.group(2).split())  # normalize 'wasm_rt_memory_t *' spacing
        c_name = m.group(3)
        params = [p.strip() for p in m.group(4).split(",") if p.strip()]
        sret_params = [p for p in params[1:] if "*" in p]
        if sret_params:
            error("export '%s' (%s) has multi-result/sret parameters %s; "
                  "not supported by the export wrapper generator"
                  % (m.group(1), c_name, sret_params))
        exports.append({
            "wasm_name": m.group(1),
            "c_name": c_name,
            "ret": ret,
            "params": params,
        })
        matched_spans.append(m.span())

    # An export comment with no matched declaration means an export shape we
    # don't understand (e.g. an immutable global) — say so instead of
    # dropping it silently.
    for cm in re.finditer(r"/\*\s*export:\s*'([^']+)'\s*\*/", text):
        if not any(s <= cm.start() < e for s, e in matched_spans):
            warn("export '%s' found in %s but its declaration was not "
                 "recognized; it will not be wrapped" % (cm.group(1), h_path))

    return exports


# Import declarations share the header's comment-annotation convention:
# /* import: 'env' 'host_add' */ followed by the full prototype.  The
# prototype is kept verbatim (whitespace-normalized) for the generated host
# header; anything wasm2c emits that we cannot parse is a loud warning,
# never a silently missing contract entry.
IMPORT_DECL_RE = re.compile(
    r"/\*\s*import:\s*'([^']+)'\s*'([^']+)'\s*\*/\s*"
    r"([a-zA-Z_][a-zA-Z0-9_]*\s*\*?)\s*"
    r"([a-zA-Z_][a-zA-Z0-9_]*)\s*\(([^()]*)\)\s*;"
)


def parse_imports(h_path):
    """Extract import declarations from the generated header (K2 symbol
    contract: imports stay undefined in the module; the loader binds them
    from host-provided wasm2c-named symbols at load time).

    Returns a list of dicts: { 'module': 'env', 'name': 'host_add',
      'c_name': 'w2c_env_host_add',
      'proto': 'u32 w2c_env_host_add(struct w2c_env*, u32, u32)' }
    """
    with open(h_path, "r") as f:
        text = f.read()

    imports = []
    matched_spans = []
    for m in IMPORT_DECL_RE.finditer(text):
        proto = "%s %s(%s)" % (m.group(3), m.group(4), m.group(5).strip())
        imports.append({
            "module": m.group(1),
            "name": m.group(2),
            "c_name": m.group(4),
            "proto": " ".join(proto.split()),
        })
        matched_spans.append(m.span())

    for cm in re.finditer(r"/\*\s*import:\s*'([^']+)'\s*'([^']+)'\s*\*/", text):
        if not any(s <= cm.start() < e for s, e in matched_spans):
            warn("import '%s.%s' found in %s but its declaration was not "
                 "recognized; it will not appear in the generated imports "
                 "header" % (cm.group(1), cm.group(2), h_path))

    return imports


# Wrapper names share the module symbol namespace with the runtime and libc
# memfuncs; a collision would silently shadow or duplicate symbols.
RESERVED_NAME_PREFIXES = ("wasm_rt_", "wasm2c_", "w2c_", "udynlink_", "__wasm")
RESERVED_NAMES = {"memcpy", "memmove", "memset", "memcmp", "malloc", "free",
                  "calloc", "realloc", "abort", "main"}


def check_export_collisions(exports, wrapper_prefix):
    for exp in exports:
        name = wrapper_prefix + exp["wasm_name"]
        if name in RESERVED_NAMES or name.startswith(RESERVED_NAME_PREFIXES):
            error("export name '%s' collides with a reserved runtime/libc "
                  "symbol; rename the wasm export or pass --wrapper-prefix"
                  % name)


def generate_imports_header(path, module_name, imports):
    """Emit the host-side symbol contract: the exact prototypes the host
    firmware must implement so the loader can bind the module's imports at
    load time.  Mirrors the shim's struct w2c_env definition."""
    guard = re.sub(r"[^A-Za-z0-9]", "_", os.path.basename(path)).upper()
    lines = [
        "/* %s — generated by mkwasm2c-module; do not edit." % os.path.basename(path),
        " *",
        " * Symbol contract for module '%s': the functions below are UNDEFINED" % module_name,
        " * in the module.  The host firmware implements them with exactly these",
        " * signatures; the udynlink loader binds them at load time through",
        " * udynlink_external_resolve_symbol().",
        " *",
        " * The first parameter of every import is the import environment",
        " * (struct w2c_env, defined below — the module's shim embeds the same",
        " * definition).  The host attaches per-module context to it via",
        " * <mod>_set_env_user().",
        " *",
        " * Synergy: feed the symbol names below to scripts/mkhostsyms to build",
        " * an O(1) host-side symbol table for resolution.",
        " */",
        "#ifndef %s" % guard,
        "#define %s" % guard,
        "",
        "#include <stdint.h>",
        "",
        "/* Same type aliases as wasm-rt.h; the shared guard keeps the two",
        " * headers safe to include together in either order. */",
        "#ifndef WASM_RT_CORE_TYPES_DEFINED",
        "#define WASM_RT_CORE_TYPES_DEFINED",
        "typedef uint8_t  u8;",
        "typedef int8_t   s8;",
        "typedef uint16_t u16;",
        "typedef int16_t  s16;",
        "typedef uint32_t u32;",
        "typedef int32_t  s32;",
        "typedef uint64_t u64;",
        "typedef int64_t  s64;",
        "typedef float    f32;",
        "typedef double   f64;",
        "#endif",
        "",
        "struct w2c_env { void* user; };",
        "",
    ]
    for imp in imports:
        lines.append("/* import: '%s' '%s' */" % (imp["module"], imp["name"]))
        lines.append("%s;" % imp["proto"])
        lines.append("")
    lines.append("#endif /* %s */" % guard)
    with open(path, "w") as f:
        f.write("\n".join(lines) + "\n")


EXPORT_DECL_RE = re.compile(
    # /* export: 'name' */ ret [*] c_name(params);  — params have no nested
    # parens in wasm2c output (funcref values are plain typedef'd pointers).
    r"/\*\s*export:\s*'([^']+)'\s*\*/\s*"
    r"([a-zA-Z_][a-zA-Z0-9_]*\s*\*?)\s*"
    r"([a-zA-Z_][a-zA-Z0-9_]*)\s*\(([^()]*)\)\s*;"
)

# ---------------------------------------------------------------------------
# Generate shim file
# ---------------------------------------------------------------------------

def generate_shim(shim_path, module_name, h_name, mem_info, exports, imports, args, memory_mode):
    """Write a setup shim: lazy singleton instantiation + export wrappers.

    Build configuration (memory model, page size, trap policy) lives in
    wasm_rt_config.h, generated separately so it reaches every translation
    unit via wasm-rt.h — never duplicated here.  When the module imports
    host functions, the shim is the wasm2c "embedder": it defines
    struct w2c_env and passes it to instantiate (K2 symbol contract).
    """
    lines = []
    lines.append("/* Auto-generated shim for wasm2c -> udynlink.  Do not edit. */")
    lines.append("")
    lines.append('#include "%s"' % h_name)
    lines.append("")
    # Import environment: wasm2c leaves struct w2c_env opaque (it is the
    # embedder's type).  The shim is the embedder; the generated
    # <mod>_imports.h mirrors this definition so host and module agree on
    # the layout of the one context word.
    if imports:
        lines.append("struct w2c_env { void* user; };")
        lines.append("static struct w2c_env __wasm_env;")
        lines.append("")

    # Custom malloc / free hooks
    if args.malloc:
        lines.append("void* %s(size_t);" % args.malloc)
        lines.append("void* wasm_rt_malloc(size_t size) { return %s(size); }" % args.malloc)
        lines.append("")
    if args.free:
        lines.append("void %s(void*);" % args.free)
        lines.append("void wasm_rt_mem_free(void* p) { %s(p); }" % args.free)
        lines.append("")

    # External memory: the buffer setter is part of the module's public API
    if memory_mode == "external" and mem_info["has_memory"]:
        lines.append("void %s_set_memory(void* buf, size_t capacity_bytes) {" % module_name)
        lines.append("    wasm_rt_set_external_memory(buf, capacity_bytes);")
        lines.append("}")
        lines.append("")
    # Import env context setter: the host attaches per-module user data
    # that import functions receive through their env parameter
    if imports:
        lines.append("void %s_set_env_user(void* user) {" % module_name)
        lines.append("    __wasm_env.user = user;")
        lines.append("}")
        lines.append("")

    # Instance type and instantiate function names
    instance_type = "w2c_%s" % module_name
    instantiate_func = "wasm2c_%s_instantiate" % module_name

    if mem_info["has_memory"] or exports or imports:
        lines.append("static %s __wasm_instance;" % instance_type)
        lines.append("static int __wasm_instantiated = 0;")
        lines.append("")
        lines.append("static void __wasm_ensure_instantiated(void) {")
        lines.append("    if (!__wasm_instantiated) {")
        if imports:
            lines.append("        %s(&__wasm_instance, &__wasm_env);" % instantiate_func)
        else:
            lines.append("        %s(&__wasm_instance);" % instantiate_func)
        lines.append("        __wasm_instantiated = 1;")
        lines.append("    }")
        lines.append("}")
        lines.append("")

    # Baked wrapper recovery (--wrappers-recover): one shared one-shot
    # recovery buffer, armed by every wrapper on entry.  Not re-entrant:
    # do not nest module-export calls through host imports while armed.
    if args.wrappers_recover and exports:
        lines.append("/* Shared one-shot recovery buffer for the baked wrappers.  A trapped")
        lines.append(" * wrapper returns the 0 sentinel; query wasm_rt_last_trap() for the")
        lines.append(" * code.  Not re-entrant: do not nest module-export calls through")
        lines.append(" * host imports while a wrapper is on the stack. */")
        lines.append("static jmp_buf __wasm_recovery_buf;")
        lines.append("")
    # Export wrappers — exported for the host, named after the wasm export
    # (plus --wrapper-prefix)
    for exp in exports:
        c_name = exp["c_name"]
        wrapper_name = args.wrapper_prefix + exp["wasm_name"]
        ret = exp["ret"]
        params = exp["params"]

        # Build parameter list for the wrapper, skipping the instance pointer
        wrapper_params = []
        call_args = ["&__wasm_instance"]
        for i, p in enumerate(params[1:]):
            pname = "p%d" % i
            wrapper_params.append("%s %s" % (p, pname))
            call_args.append(pname)

        lines.append("%s %s(%s) {" % (
            ret,
            wrapper_name,
            ", ".join(wrapper_params) if wrapper_params else "void"
        ))
        if args.wrappers_recover:
            lines.append("    if (setjmp(__wasm_recovery_buf) == 0) {")
            lines.append("        wasm_rt_set_recovery(&__wasm_recovery_buf);")
            lines.append("        __wasm_ensure_instantiated();")
            call = "%s(%s);" % (c_name, ", ".join(call_args))
            if ret == "void":
                lines.append("        %s" % call)
                lines.append("    }")
            else:
                lines.append("        return %s" % call)
                lines.append("    }")
                # Sentinel ambiguity is documented: callers that need a
                # clean error channel use --recoverable-traps instead.
                lines.append("    return (%s)0; /* trap sentinel */" % ret)
        else:
            lines.append("    __wasm_ensure_instantiated();")
            if ret == "void":
                lines.append("    %s(%s);" % (c_name, ", ".join(call_args)))
            else:
                lines.append("    return %s(%s);" % (c_name, ", ".join(call_args)))
        lines.append("}")
        lines.append("")

    if not exports:
        # Keep the translation unit non-empty when there is nothing to wrap
        lines.append("typedef int __wasm2c_shim_keep;")
        lines.append("")

    with open(shim_path, "w") as f:
        f.write("\n".join(lines))


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def main():
    parser = argparse.ArgumentParser(description="Compile .wasm/.wat to a udynlink loadable .bin module")
    parser.add_argument("input", help="Input .wasm or .wat file")
    parser.add_argument("--target", default=targets.DEFAULT_TARGET,
                        help="Target name from targets.py (default: %s)" % targets.DEFAULT_TARGET)
    parser.add_argument("--mcpu", default="cortex-m4", help="Target CPU (default: cortex-m4)")
    parser.add_argument("-O", dest="opt_level", default="s",
                        help="Optimization level: 0, s, 2, 3, z (default: s)")
    parser.add_argument("--bin-name", default=None, help="Output binary path")
    parser.add_argument("--gen-c-header", action="store_true",
                        help="Generate embeddable C header")
    parser.add_argument("--header-path", default=".",
                        help="Path for generated header (default: current dir)")
    parser.add_argument("--gen-imports-header", action="store_true",
                        help="Emit <bin>_imports.h: the host-side symbol contract (also generated "
                             "automatically with --gen-c-header when the module has imports)")
    parser.add_argument("--public-symbols", default=None,
                        help="Comma-separated list of symbols to export (default: wrapper names only)")
    parser.add_argument("--no-prologue", action="store_true",
                        help="Skip assembly prologue generation")
    parser.add_argument("--mod-version", default="1.0",
                        help="Module ABI version (default: 1.0)")
    parser.add_argument("--udynlink-version", default="3.0",
                        help="Loader ABI version (default: 3.0)")
    parser.add_argument("--memory", choices=["auto", "static", "dynamic", "external"], default="auto",
                        help="Linear memory model (default: auto — static unless the module uses "
                             "memory.grow; external = host registers a buffer before first call)")
    parser.add_argument("--recoverable-traps", action="store_true",
                        help="Traps longjmp to a host-registered one-shot recovery point "
                             "(wasm_rt_set_recovery, exported) instead of halting; fatal "
                             "fallback when none is registered")
    parser.add_argument("--wrappers-recover", action="store_true",
                        help="Bake recovery into the export wrappers: a trapped wrapper returns "
                             "the 0 sentinel and wasm_rt_last_trap() (exported) reports the code; "
                             "implies --recoverable-traps machinery")
    parser.add_argument("--custom-page-size", type=int, default=None,
                        help="Override the default 65536-byte wasm page size")
    parser.add_argument("--no-conformance-flags", action="store_true",
                        help="Omit wasm2c conformance flags (%s)" % WASM2C_CONFORMANCE_FLAGS)
    parser.add_argument("--trap-handler", default=None,
                        help="Host-provided trap handler symbol name; called on trap before the "
                             "fatal halt (undefined in the module, resolved at load time)")
    parser.add_argument("--stack-depth-limit", type=int, default=None, metavar="N",
                        help="Count wasm call depth; trap WASM_RT_TRAP_EXHAUSTION beyond N nested calls")
    parser.add_argument("--malloc", default=None,
                        help="Custom malloc hook name (default: udynlink_external_malloc)")
    parser.add_argument("--export-all", action="store_true",
                        help="Export every defined symbol in the symtab (default: wrapper names only)")
    parser.add_argument("--free", default=None,
                        help="Custom free hook name (default: udynlink_external_free)")
    parser.add_argument("--wrapper-prefix", default="",
                        help="Prefix for generated export wrapper names (avoids host symbol collisions)")
    parser.add_argument("--build-flags", default=None,
                        help="Extra compiler flags (prepended to compile command)")
    parser.add_argument("--no-export-wrappers", action="store_true",
                        help="Do not auto-generate export wrapper functions")
    parser.add_argument("--workdir", default=None,
                        help="Directory for intermediates and the default .bin output (default: private temp dir)")
    parser.add_argument("--keep", action="store_true",
                        help="Keep the temp work directory for debugging (implied by --workdir)")
    parser.add_argument("--no-verbose", action="store_true")
    parser.add_argument("--no-debug", action="store_true")

    args = parser.parse_args()

    # Validate target
    try:
        target_meta = targets.get_target(args.target)
    except ValueError as e:
        error(str(e))

    if not any(a.startswith("--mcpu") for a in sys.argv[1:]):
        args.mcpu = target_meta["mcpu"]

    wasm2c = find_wasm2c()
    check_wasm2c_version(wasm2c)

    # Resolve every output path to absolute BEFORE any chdir: mkmodule runs
    # with the work directory as cwd, so relative paths would land there.
    input_path = os.path.abspath(args.input)
    if not os.path.isfile(input_path):
        error("Input file not found: %s" % input_path)

    path, basename, ext = split_fname(input_path)
    module_name = basename  # e.g. "add" from add.wat

    if args.bin_name is None:
        args.bin_name = os.path.join(path, "mod_%s.bin" % module_name)
    else:
        args.bin_name = os.path.abspath(args.bin_name)
    args.header_path = os.path.abspath(args.header_path)

    if args.workdir:
        workdir = os.path.abspath(args.workdir)
        os.makedirs(workdir, exist_ok=True)
    else:
        workdir = tempfile.mkdtemp(prefix="mkwasm2c_")

    try:
        # .wat input: assemble with the same wabt toolchain first
        if ext == ".wat":
            wat2wasm = os.path.join(os.path.dirname(wasm2c), "wat2wasm")
            if not os.path.isfile(wat2wasm):
                wat2wasm = shutil.which("wat2wasm")
            if not wat2wasm:
                error("wat2wasm not found (needed for .wat input); install wabt or run 'just setup-wabt'")
            tmp_wasm = os.path.join(workdir, basename + ".wasm")
            cc.run_tool([wat2wasm, input_path, "-o", tmp_wasm], "wat2wasm",
                        verbose=not args.no_verbose)
        else:
            tmp_wasm = input_path

        # Run wasm2c
        generated_c = os.path.join(workdir, basename + ".c")
        generated_h = os.path.join(workdir, basename + ".h")
        cc.run_tool([wasm2c, tmp_wasm, "-o", generated_c], "wasm2c",
                    verbose=not args.no_verbose)

        # Patch generated C file
        patch_wasm2c_generated(generated_c, args)

        # Inspect memory usage
        mem_info = inspect_memory_usage(generated_c)
        debug("Memory info: %s" % mem_info, args)

        memory_mode = resolve_memory_mode(args, mem_info)

        # Parse exports
        exports = parse_exports(generated_h)
        if args.no_export_wrappers:
            if not args.public_symbols:
                warn("--no-export-wrappers without --public-symbols: "
                     "the module will export only its name entry")
            exports = []
        else:
            check_export_collisions(exports, args.wrapper_prefix)
        debug("Exports found: %s" % [e["wasm_name"] for e in exports], args)

        # Parse imports (K2 symbol contract): the generated header lists
        # every host function the module calls; the loader binds them at
        # load time from the host's wasm2c-named implementations.
        imports = parse_imports(generated_h)
        debug("Imports found: %s" % ["%s.%s" % (i["module"], i["name"]) for i in imports], args)
        imports_header_name = os.path.splitext(os.path.basename(args.bin_name))[0] + "_imports.h"
        if imports and (args.gen_imports_header or args.gen_c_header):
            generate_imports_header(os.path.join(args.header_path, imports_header_name),
                                    module_name, imports)
        elif args.gen_imports_header:
            warn("--gen-imports-header: module has no imports; no header written")

        # Per-module build configuration, picked up by every TU via wasm-rt.h
        generate_config_header(os.path.join(workdir, "wasm_rt_config.h"),
                               memory_mode, mem_info, args)

        # Copy runtime + host-callback header next to the sources so one
        # mkmodule invocation builds everything; canonical copies stay in
        # udynlink/wasm2c_runtime/
        shutil.copy2(RUNTIME_C, os.path.join(workdir, "wasm-rt-udynlink.c"))
        shutil.copy2(RUNTIME_H, os.path.join(workdir, "wasm-rt.h"))
        shutil.copy2(os.path.join(REPO_ROOT, "udynlink", "udynlink_externals.h"),
                     os.path.join(workdir, "udynlink_externals.h"))

        shim_name = basename + "_udynlink_shim.c"
        generate_shim(os.path.join(workdir, shim_name), module_name,
                      basename + ".h", mem_info, exports, imports, args, memory_mode)

        # Build sources list (shim first so bin name is based on it)
        sources = [shim_name, basename + ".c", "wasm-rt-udynlink.c"]

        # Default public symbols: the wrapper names (+ the external-memory
        # setter).  mkmodule adds the module-name entry and __init_array by
        # itself, so runtime internals and libc names stay out of the symtab.
        if args.public_symbols:
            public_symbols = set(args.public_symbols.split(","))
        else:
            public_symbols = {module_name}
            public_symbols.update(args.wrapper_prefix + e["wasm_name"] for e in exports)
            if imports:
                public_symbols.add("%s_set_env_user" % module_name)
            if memory_mode == "external" and mem_info["has_memory"]:
                public_symbols.add("%s_set_memory" % module_name)
            if args.recoverable_traps or args.wrappers_recover:
                # The host reaches the trap state through the symtab.
                public_symbols.add("wasm_rt_last_trap")
            if args.recoverable_traps:
                public_symbols.add("wasm_rt_set_recovery")

        # Run mkmodule from the work directory
        old_cwd = os.getcwd()
        os.chdir(workdir)
        try:
            build_flags = args.build_flags or ""
            if not args.no_conformance_flags:
                build_flags = (WASM2C_CONFORMANCE_FLAGS + " " + build_flags).strip()
            # --no-verbose maps to build_module(verbose=False); --no-debug is
            # not covered by build_module, so pass it verbatim.
            extra_args = ["--no-debug"] if args.no_debug else []
            cc.build_module(
                sources,
                public_symbols=public_symbols,
                strip_non_public=not args.export_all,
                build_flags=build_flags,
                target=args.target,
                mcpu=args.mcpu,
                opt_level=args.opt_level,
                bin_name=args.bin_name,
                module_name=module_name,
                workdir=workdir,
                gen_c_header=args.gen_c_header,
                header_path=args.header_path,
                no_prologue=args.no_prologue,
                mod_version=args.mod_version,
                udynlink_version=args.udynlink_version,
                extra_args=extra_args,
                verbose=not args.no_verbose,
            )
        finally:
            os.chdir(old_cwd)

        # Report the generated header if requested
        if args.gen_c_header:
            header_name = os.path.splitext(os.path.basename(args.bin_name))[0] + "_module_data.h"
            src_header = os.path.join(args.header_path, header_name)
            if os.path.isfile(src_header):
                print("Generated header: %s" % src_header)

    finally:
        if not args.workdir:
            if args.keep:
                print("Kept work directory: %s" % workdir)
            else:
                shutil.rmtree(workdir, ignore_errors=True)

    print("Done. Binary: %s" % args.bin_name)


if __name__ == "__main__":
    main()
