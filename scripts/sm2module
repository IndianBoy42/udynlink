#!/usr/bin/env python3
"""sm2module — compile a JSON state chart into a udynlink module (UDLM image).

sm2module is the worked example of a custom codegen integration (see
docs/codegen-integrations.md); read it as the template for your own.

Input: a JSON chart with flat states, string events, and (from, event, to)
transitions with optional named actions:

    {
      "name": "door",
      "initial": "closed",
      "states":  ["closed", "open", "locked"],
      "events":  ["push", "lock", "unlock"],
      "transitions": [
        {"from": "closed", "event": "push", "to": "open"},
        {"from": "open",   "event": "lock", "to": "locked",
         "action": "lock"},
        {"from": "locked", "event": "unlock", "to": "open",
         "action": "unlock"}
      ]
    }

Module ABI (prefix defaults to the chart basename so several state-machine
modules never collide; pass --export-prefix '' for the bare names):

    uint8_t     <pfx>_step(uint8_t state, uint8_t event, void *ctx);
    const char *<pfx>_state_name(uint8_t state);
    const char *<pfx>_event_name(uint8_t event);
    uint8_t     <pfx>_event_id(const char *name);

`step` returns the next state (unchanged when the event has no transition or
arguments are out of range).  `ctx` is an unopinionated caller pointer,
forwarded to actions only.  If the chart declares actions, they become
extern symbols `<pfx>_action_<name>(void *ctx)` that the host firmware must
implement and resolve via udynlink_external_resolve_symbol() — the module
then needs the runtime split (host binds them at load).  A chart without
actions compiles to a fully self-contained module with ZERO externs.

The transition matrix and name tables are compiled INTO the module (.rodata).
The host gets <chart>_contract.h: state/event constants, the ABI prototypes,
and — when the chart has actions — the hook prototypes it must implement.
"""

import argparse
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import codegen_common as cc  # noqa: E402

NO_TRANSITION = 0xFF

WRAPPER_TEMPLATE = """\
/* Generated by scripts/sm2module from {chart_name} — do not edit. */
#include <stdint.h>
#include <stddef.h>
#include "{contract_header}"

#define {PFX}_N_STATES  ({n_states}u)
#define {PFX}_N_EVENTS  ({n_events}u)

/* transition matrix [state][event]; 0xFF = no transition */
static const uint8_t {pfx}_trans[{n_states}][{n_events}] = {{
{trans_rows}
}};
/* name blob: NUL-separated state names, then event names */
static const char {pfx}_name_blob[] =
    "{name_blob}";

/* offsets into the name blob: [0..{n_states}) states, then events */
static const uint16_t {pfx}_name_offs[{n_all_names}] = {{
    {name_offs}
}};


uint8_t {step_fn}(uint8_t state, uint8_t event, void *ctx)
{{
    uint8_t next;
    if (state >= {PFX}_N_STATES || event >= {PFX}_N_EVENTS)
        return state;
    next = {pfx}_trans[state][event];
    if (next == {NO_TRANSITION}u || next == state)
        return state;
{action_dispatch}    return next;
}}

const char *{state_name_fn}(uint8_t state)
{{
    return state < {PFX}_N_STATES
               ? {pfx}_name_blob + {pfx}_name_offs[state] : 0;
}}

const char *{event_name_fn}(uint8_t event)
{{
    return event < {PFX}_N_EVENTS
               ? {pfx}_name_blob + {pfx}_name_offs[{PFX}_N_STATES + event]
               : 0;
}}

uint8_t {event_id_fn}(const char *name)
{{
    uint8_t i;
    if (!name)
        return {NO_TRANSITION}u;
    for (i = 0; i < {PFX}_N_EVENTS; i++) {{
        const char *a = {pfx}_name_blob
                        + {pfx}_name_offs[{PFX}_N_STATES + i];
        const char *b = name;
        while (*a && *a == *b) {{ a++; b++; }}
        if (*a == *b)
            return i;
    }}
    return {NO_TRANSITION}u;
}}
"""

CONTRACT_TEMPLATE = """\
/* Generated by scripts/sm2module from {chart_name} — host-side contract.
{self_contained} * The transition tables live in the module; this header is the shared ABI. */
#ifndef {guard}_CONTRACT_H
#define {guard}_CONTRACT_H

#include <stdint.h>
#include <stddef.h>

#ifdef __cplusplus
extern "C" {{
#endif

/* states */
{state_defines}

/* events */
{event_defines}

/* Process `event` in `state`; returns the next state (unchanged when the
 * event has no transition). `ctx` is forwarded to actions uninterpreted. */
uint8_t {step_fn}(uint8_t state, uint8_t event, void *ctx);

/* names (NULL when out of range); event_id maps a name back to its id
 * ({NO_TRANSITION}u when unknown) */
const char *{state_name_fn}(uint8_t state);
const char *{event_name_fn}(uint8_t event);
uint8_t {event_id_fn}(const char *name);
{action_protos}#ifdef __cplusplus
}}
#endif

#endif /* {guard}_CONTRACT_H */
"""

ACTION_PROTO_TEMPLATE = """\
/* action hook: implement in the host firmware and resolve by name in
 * udynlink_external_resolve_symbol() ("<pfx>_action_<name>") */
void {action_fn}(void *ctx);
"""


def load_chart(path):
    """Parse and validate the chart; returns the dict."""
    with open(path) as f:
        chart = json.load(f)
    for key in ("name", "initial", "states", "events", "transitions"):
        if key not in chart:
            sys.exit("error: chart is missing '%s'" % key)
    states, events = chart["states"], chart["events"]
    if not states or not events:
        sys.exit("error: chart needs at least one state and one event")
    if chart["initial"] not in states:
        sys.exit("error: initial state '%s' is not in states"
                 % chart["initial"])
    seen = set()
    for t in chart["transitions"]:
        for key in ("from", "event", "to"):
            if key not in t:
                sys.exit("error: transition missing '%s': %s" % (key, t))
        if t["from"] not in states:
            sys.exit("error: transition 'from' unknown state: %s" % t["from"])
        if t["to"] not in states:
            sys.exit("error: transition 'to' unknown state: %s" % t["to"])
        if t["event"] not in events:
            sys.exit("error: transition unknown event: %s" % t["event"])
        key = (t["from"], t["event"])
        if key in seen:
            sys.exit("error: duplicate transition %s --%s-->"
                     % (t["from"], t["event"]))
        seen.add(key)
    return chart


def _name_offsets(names):
    """Byte offsets of each NUL-terminated name within the packed blob."""
    offs, pos = [], 0
    for n in names:
        offs.append(pos)
        pos += len(n) + 1  # name + NUL separator
    return offs


def main():
    ap = argparse.ArgumentParser(
        prog="sm2module",
        description="Compile a JSON state chart into a udynlink module "
                    "(UDLM image).",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="Extra arguments after '--' are forwarded to mkmodule.\n"
               "A chart without actions builds a fully self-contained "
               "module (zero externs); with actions, the host implements "
               "and resolves <pfx>_action_<name> hooks.")
    ap.add_argument("chart", help="JSON state chart")
    ap.add_argument("--export-prefix", metavar="PFX", default=None,
                    help="prefix for exported names (default: the chart "
                         "basename; '' for the bare names)")
    ap.add_argument("--out-dir", help="output directory (default: next to "
                    "the chart)")
    ap.add_argument("--module-name", help="udynlink module name "
                    "(default: <chart_basename>_mod)")
    ap.add_argument("--target", default="cortex-m4",
                    help="mkmodule target (default: cortex-m4)")
    ap.add_argument("--gen-c-header", action="store_true",
                    help="also emit <module>_module_data.h for embedding")
    ap.add_argument("--verbose", action="store_true", help="print commands")
    args, mkmodule_args = ap.parse_known_args()

    if not args.chart.endswith(".json"):
        sys.exit("error: '%s' does not look like a .json chart; extra "
                 "mkmodule arguments (e.g. -O s) must go after '--': "
                 "sm2module [options] chart.json -- -O s" % args.chart)
    chart_path = os.path.abspath(args.chart)
    if not os.path.isfile(chart_path):
        sys.exit("error: no such file: %s" % args.chart)
    base = os.path.splitext(os.path.basename(chart_path))[0]
    prefix = (args.export_prefix if args.export_prefix is not None
              else cc.sanitize_identifier(base))
    out_dir = (os.path.abspath(args.out_dir) if args.out_dir
               else os.path.dirname(chart_path))
    os.makedirs(out_dir, exist_ok=True)

    chart = load_chart(chart_path)
    states = chart["states"]
    events = chart["events"]
    transitions = chart["transitions"]
    state_idx = {s: i for i, s in enumerate(states)}
    event_idx = {e: i for i, e in enumerate(events)}

    def q(name):
        return "%s_%s" % (prefix, name) if prefix else name

    step_fn = q("step")
    state_name_fn = q("state_name")
    event_name_fn = q("event_name")
    event_id_fn = q("event_id")
    pfx = prefix or base
    cc.check_identifiers(
        [step_fn, state_name_fn, event_name_fn, event_id_fn]
        + [q("action_%s" % t["action"])
           for t in transitions if t.get("action")],
        "export name")

    # transition matrix [state][event] + parallel action-name matrix
    actions = sorted({t["action"] for t in transitions if t.get("action")})
    actm = [[None] * len(events) for _ in states]
    trans = [[NO_TRANSITION] * len(events) for _ in states]
    for t in transitions:
        s, e = state_idx[t["from"]], event_idx[t["event"]]
        trans[s][e] = state_idx[t["to"]]
        if t.get("action"):
            actm[s][e] = t["action"]

    trans_rows = ",\n".join(
        "    {/* %s */ %s}" % (s, ", ".join("0x%02X" % v for v in row))
        for s, row in zip(states, trans))

    # action dispatch: a flat switch on (state, event) calling the extern
    # hooks directly — emitted only when the chart declares actions, so
    # action-free charts stay fully self-contained (zero externs)
    if actions:
        action_dispatch = ("    switch (state * %du + event) {\n"
                           % len(events)
                           + "".join(
                               "    case %du: %s(ctx); break;\n"
                               % (s * len(events) + e,
                                  q("action_%s" % actm[s][e]))
                               for s in range(len(states))
                               for e in range(len(events))
                               if actm[s][e] is not None)
                           + "    }\n")
    else:
        action_dispatch = ""

    wrapper = os.path.join(out_dir, base + "_mod.c")
    with open(wrapper, "w") as f:
        f.write(WRAPPER_TEMPLATE.format(
            chart_name=os.path.basename(chart_path),
            contract_header=base + "_contract.h",
            PFX=pfx.upper(), pfx=pfx,
            n_states=len(states), n_events=len(events),
            NO_TRANSITION=NO_TRANSITION,
            trans_rows=trans_rows,
            name_blob="\\0".join(
                s.replace("\\", "\\\\").replace('"', '\\"')
                for s in states + events) + "\\0",
            n_all_names=len(states) + len(events),
            name_offs=", ".join(
                str(o) + "u" for o in _name_offsets(states + events)),
            step_fn=step_fn, state_name_fn=state_name_fn,
            event_name_fn=event_name_fn, event_id_fn=event_id_fn,
            action_dispatch=action_dispatch))

    contract = os.path.join(out_dir, base + "_contract.h")
    with open(contract, "w") as f:
        f.write(CONTRACT_TEMPLATE.format(
            chart_name=os.path.basename(chart_path),
            self_contained=(
                " * Fully self-contained module: no action hooks, zero "
                "externs.\n" if not actions else
                " * The host implements the action hooks below and resolves\n"
                " * them by name in udynlink_external_resolve_symbol().\n"),
            guard=cc.api_header_guard(base),
            state_defines="\n".join(
                "#define %s_STATE_%s %du"
                % (pfx.upper(), cc.sanitize_identifier(s).upper(), i)
                for i, s in enumerate(states)),
            event_defines="\n".join(
                "#define %s_EVENT_%s %du"
                % (pfx.upper(), cc.sanitize_identifier(e).upper(), i)
                for i, e in enumerate(events)),
            step_fn=step_fn, state_name_fn=state_name_fn,
            event_name_fn=event_name_fn, event_id_fn=event_id_fn,
            NO_TRANSITION=NO_TRANSITION,
            action_protos="".join(
                ACTION_PROTO_TEMPLATE.format(action_fn=q("action_%s" % a))
                + "\n" for a in actions)))

    exports = [step_fn, state_name_fn, event_name_fn, event_id_fn]
    bin_path = cc.build_module(
        [wrapper],
        public_symbols=exports, strip_non_public=True,
        build_flags="-I%s" % out_dir,
        target=args.target, module_name=args.module_name,
        workdir=out_dir, gen_c_header=args.gen_c_header,
        header_path=out_dir, extra_args=mkmodule_args,
        verbose=args.verbose)

    cc.report_size(bin_path, args.module_name or (base + "_mod"))
    extern_note = ("externs: %s" % ",".join(q("action_" + a) for a in actions)
                   if actions else "externs: none (self-contained)")
    print("wrote %s (states=%d events=%d transitions=%d, exports: %s, %s)"
          % (bin_path, len(states), len(events), len(transitions),
             ",".join(exports), extern_note))


if __name__ == "__main__":
    main()
