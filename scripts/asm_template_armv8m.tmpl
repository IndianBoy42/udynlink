    .syntax unified
    .arch armv8-m.main

    .text
    .thumb

{% for s, actname in sym_names.items() %}
    .thumb_func
    .align 1
    .section {{sym_sections[s]}}
    {# Weak function prologues must be emitted as .weak so the final ELF
       preserves STB_WEAK binding.  Non-weak exports use .globl. #}
    {% if s in weak_names %}
    .weak {{s}}
    {% else %}
    .globl {{s}}
    {% endif %}
    .type {{s}}, %function
    .extern {{actname}}
    .type {{actname}}, %function
{{s}}:
    push    {r9, lr}
    bl      {{actname}}
    pop     {r9, pc}

    .size   {{s}}, . - {{s}}
{% endfor %}

    .end
