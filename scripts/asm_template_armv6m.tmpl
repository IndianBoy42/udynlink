    .syntax unified
    .arch armv6-m

    .text
    .thumb

{% for s, actname in sym_names.items() %}
    .thumb_func
    .align 1
    .section .text_nogc, "x"
    {# Weak function prologues must be emitted as .weak so the final ELF
       preserves STB_WEAK binding.  Non-weak exports use .globl. #}
    {% if s in weak_names %}
    .weak {{s}}
    {% else %}
    .globl {{s}}
    {% endif %}
    .type {{s}}, %function
    .extern {{actname}}
    .type {{actname}}, %function
{{s}}:
    mov     r2, r9
    push    {r1, r2, lr}
    bl      {{actname}}
    ldr     r2, [sp, #4]
    mov     r9, r2
    pop     {r1, r2, pc}

    .size   {{s}}, . - {{s}}
{% endfor %}

    .end
