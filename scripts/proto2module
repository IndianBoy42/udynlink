#!/usr/bin/env python3
"""proto2module — compile a .proto file into a udynlink module (UDLM image).

Each module exports exactly two functions per selected message, wrapping the
nanopb codec for that message:

    int  parse(const unsigned char *in, size_t in_len, void *msg);
    int  write(const void *msg, unsigned char *out, size_t *out_len);

`parse` decodes a protobuf buffer into a caller-provided struct; `write`
encodes the caller's struct and reports bytes written via *out_len (capacity
in, bytes written out). The host allocates the struct and needs the generated
pb.h header (emitted next to the module) plus the nanopb runtime linked into
the firmware and exported through udynlink_external_resolve_symbol() under
the names pb_decode, pb_encode, pb_istream_from_buffer, pb_ostream_from_buffer.

The message schema (pb_msgdesc_t tables) is compiled INTO the module, so a
"1 module == 1 struct" deployment only pays for the structs it loads. The
nanopb runtime stays host-side once — bundling it per module costs ~9 KB.

Pipeline: protoc --nanopb_out -> generated <proto>.pb.c/.pb.h -> wrapper .c
(exports parse/write) -> mkmodule (PIC compile + UDLM packaging).

Requirements (overridable via --protoc/--plugin/--nanopb-dir or the
UDYNLINK_PROTOC / UDYNLINK_NANOPB_PLUGIN / UDYNLINK_NANOPB_DIR env vars):
  * protoc
  * nanopb generator plugin (pip: `uv pip install nanopb==0.4.9.*`; keep the
    generator in sync with the vendored runtime, currently nanopb-0.4.9.1)
  * nanopb C runtime directory containing pb.h / pb_common.c / pb_encode.c /
    pb_decode.c / nanopb.proto (vendored at third_party/nanopb in this repo)
  * arm-none-eabi-gcc (as for mkmodule)
"""

import argparse
import os
import re
import shutil
import subprocess
import sys

REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
DEFAULT_NANOPB_DIR = os.path.join(REPO_ROOT, "third_party", "nanopb")
DEFAULT_VENV_PLUGIN = os.path.join(REPO_ROOT, ".venv", "bin", "protoc-gen-nanopb")

WRAPPER_TEMPLATE = """\
/* Generated by scripts/proto2module from {proto_name} — do not edit. */
#include <pb_encode.h>
#include <pb_decode.h>
#include "{pb_header}"

/* Decode a protobuf buffer into a caller-provided {cname} struct.
 * Returns 1 on success, 0 on failure. */
int {parse_fn}(const unsigned char *in, size_t in_len, void *msg)
{{
    pb_istream_t stream = pb_istream_from_buffer(in, in_len);
    return pb_decode(&stream, {fields}, msg) ? 1 : 0;
}}

/* Encode a caller-provided {cname} struct. *out_len is capacity on entry,
 * bytes written on success. Returns 1 on success, 0 on failure. */
int {write_fn}(const void *msg, unsigned char *out, size_t *out_len)
{{
    pb_ostream_t stream = pb_ostream_from_buffer(out, *out_len);
    int ok = pb_encode(&stream, {fields}, msg) ? 1 : 0;
    *out_len = (size_t)stream.bytes_written;
    return ok;
}}
"""

API_HEADER_TEMPLATE = """\
/* Generated by scripts/proto2module from {proto_name} — host-side ABI.
 * Link the nanopb runtime (pb_common.c, pb_encode.c, pb_decode.c) into the
 * host firmware and resolve these names in udynlink_external_resolve_symbol():
 *   pb_decode, pb_encode, pb_istream_from_buffer, pb_ostream_from_buffer
 * The struct types live in {pb_header}; the module owns the field tables. */
#ifndef {guard}_API_H
#define {guard}_API_H

#include <stddef.h>
#include "{pb_header}"

#ifdef __cplusplus
extern "C" {{
#endif

{prototypes}
#ifdef __cplusplus
}}
#endif

#endif /* {guard}_API_H */
"""

API_PROTO_TEMPLATE = """\
/* Decode in_len bytes at `in` into a {cname} struct. Returns 1 on success. */
int {parse_fn}(const unsigned char *in, size_t in_len, void *msg);

/* Encode `msg` into `out`; *out_len is capacity in, bytes written out. */
int {write_fn}(const void *msg, unsigned char *out, size_t *out_len);
"""


def find_tool(arg, env_name, names, hint):
    if arg:
        return arg
    if os.environ.get(env_name):
        return os.environ[env_name]
    for n in names:
        found = shutil.which(n)
        if found:
            return found
    sys.exit("error: %s" % hint)


def find_nanopb_dir(arg):
    if arg:
        return arg
    if os.environ.get("UDYNLINK_NANOPB_DIR"):
        return os.environ["UDYNLINK_NANOPB_DIR"]
    if os.path.isdir(DEFAULT_NANOPB_DIR) and os.path.isfile(
            os.path.join(DEFAULT_NANOPB_DIR, "pb.h")):
        return DEFAULT_NANOPB_DIR
    sys.exit("error: nanopb runtime not found. Pass --nanopb-dir, set "
             "UDYNLINK_NANOPB_DIR, or vendor pb.h/pb_*.c at "
             "third_party/nanopb.")


def message_names_from_header(pb_header_path):
    """Return the nanopb C type names defined by the generated header."""
    names = []
    with open(pb_header_path) as f:
        for line in f:
            m = re.match(r"typedef struct _([A-Za-z0-9_]+) \{", line)
            if m:
                names.append(m.group(1))
    return names


def main():
    ap = argparse.ArgumentParser(
        prog="proto2module",
        description="Compile a .proto file into a udynlink module (UDLM image).",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "--struct takes the nanopb C type name (package + message joined "
            "with '_', e.g. 'acme_sensor_TempReading' or 'SensorReading'). "
            "With one --struct the exports are parse/write; with several they "
            "are parse_<cname_lower>/write_<cname_lower>.\n\n"
            "Extra arguments after '--' are forwarded to mkmodule.\n"
            "Environment: UDYNLINK_PROTOC, UDYNLINK_NANOPB_PLUGIN, "
            "UDYNLINK_NANOPB_DIR."
        ),
    )
    ap.add_argument("proto", help=".proto file to compile")
    ap.add_argument("--struct", action="append", metavar="CNAME",
                    help="message to export (repeatable); default: the file's "
                         "only message")
    ap.add_argument("--module-name", help="udynlink module name "
                    "(default: <proto_basename>_mod)")
    ap.add_argument("--export-prefix", metavar="PFX", default=None,
                    help="prefix for the exported function names "
                    "(<PFX>_parse/<PFX>_write, or <PFX>_parse_<cname> in "
                    "multi-struct mode). Default: the .proto basename, so "
                    "several codec modules loaded together never collide "
                    "(deps-layer resolution is by bare name, first match "
                    "wins). Pass '' for the bare parse/write names.")
    ap.add_argument("--out-dir", help="output directory for generated files "
                    "and the .bin (default: next to the .proto)")
    ap.add_argument("--target", default="cortex-m4",
                    help="mkmodule target (default: cortex-m4)")
    ap.add_argument("--protoc", help="protoc executable")
    ap.add_argument("--plugin", help="protoc-gen-nanopb executable")
    ap.add_argument("--nanopb-dir", help="nanopb runtime dir (pb.h, nanopb.proto)")
    ap.add_argument("--gen-c-header", action="store_true",
                    help="also emit <module>_module_data.h for embedding")
    ap.add_argument("--verbose", action="store_true", help="print commands")
    args, mkmodule_args = ap.parse_known_args()

    # A stray unknown flag before `--` (e.g. a bare `-O s`) makes argparse
    # misassign tokens to the positional; catch it with a pointed hint
    # instead of failing on a nonexistent file.
    if not args.proto.endswith(".proto"):
        sys.exit("error: '%s' does not look like a .proto file; extra "
                 "mkmodule arguments (e.g. -O s) must go after '--': "
                 "proto2module [options] file.proto -- -O s" % args.proto)
    proto_path = os.path.abspath(args.proto)
    if not os.path.isfile(proto_path):
        sys.exit("error: no such file: %s" % args.proto)
    proto_dir = os.path.dirname(proto_path)
    proto_base = os.path.splitext(os.path.basename(proto_path))[0]
    # Default export prefix: the .proto basename, sanitized to a C identifier
    # so `my-sensor.proto` yields `my_sensor_parse`/`my_sensor_write`. An
    # explicit '' restores the bare parse/write names.
    export_prefix = (args.export_prefix if args.export_prefix is not None
                     else re.sub(r"[^A-Za-z0-9_]", "_", proto_base))
    out_dir = os.path.abspath(args.out_dir) if args.out_dir else proto_dir
    os.makedirs(out_dir, exist_ok=True)

    protoc = find_tool(args.protoc, "UDYNLINK_PROTOC", ["protoc"],
                       "protoc not found (install protobuf-compiler or set "
                       "UDYNLINK_PROTOC).")
    plugin = find_tool(
        args.plugin, "UDYNLINK_NANOPB_PLUGIN",
        ["protoc-gen-nanopb", DEFAULT_VENV_PLUGIN],
        "protoc-gen-nanopb not found (pip install nanopb, or set "
        "UDYNLINK_NANOPB_PLUGIN).")
    nanopb_dir = find_nanopb_dir(args.nanopb_dir)

    # 1. protoc --nanopb_out: generated codec + field tables.
    pb_c = os.path.join(out_dir, proto_base + ".pb.c")
    pb_h = os.path.join(out_dir, proto_base + ".pb.h")
    cmd = [protoc,
           "--plugin=protoc-gen-nanopb=%s" % plugin,
           "--nanopb_out=%s" % out_dir,
           "-I%s" % proto_dir,
           "-I%s" % nanopb_dir,
           proto_path]
    if args.verbose:
        print(" ".join(cmd))
    if subprocess.call(cmd) != 0:
        sys.exit("error: protoc/nanopb generation failed")

    # 2. Pick the message(s) to expose.
    all_msgs = message_names_from_header(pb_h)
    if not all_msgs:
        sys.exit("error: no message structs found in generated %s" % pb_h)
    structs = args.struct or (all_msgs if len(all_msgs) == 1 else [])
    if not structs:
        sys.exit("error: %s defines multiple messages (%s); pick one with "
                 "--struct" % (os.path.basename(proto_path),
                               ", ".join(all_msgs)))
    for s in structs:
        if s not in all_msgs:
            sys.exit("error: --struct '%s' not in generated header (%s)"
                     % (s, ", ".join(all_msgs)))

    def pair(cname):
        pre = export_prefix + "_" if export_prefix else ""
        if len(structs) == 1:
            return pre + "parse", pre + "write"
        return (pre + "parse_%s" % cname.lower(),
                pre + "write_%s" % cname.lower())

    # 3. Generate the wrapper .c and the host-side API header.
    wrapper = os.path.join(out_dir, proto_base + "_mod.c")
    with open(wrapper, "w") as f:
        for s in structs:
            parse_fn, write_fn = pair(s)
            f.write(WRAPPER_TEMPLATE.format(
                proto_name=os.path.basename(proto_path),
                pb_header=os.path.basename(pb_h),
                cname=s, fields="%s_fields" % s,
                parse_fn=parse_fn, write_fn=write_fn))
    api_header = os.path.join(out_dir, proto_base + "_api.h")
    with open(api_header, "w") as f:
        f.write(API_HEADER_TEMPLATE.format(
            proto_name=os.path.basename(proto_path),
            pb_header=os.path.basename(pb_h),
            guard=os.path.basename(proto_path).replace(".", "_").upper(),
            prototypes="\n".join(
                API_PROTO_TEMPLATE.format(
                    cname=s, parse_fn=pair(s)[0], write_fn=pair(s)[1])
                for s in structs)))

    # 4. mkmodule: PIC compile + UDLM packaging.
    exports = []
    for s in structs:
        exports.extend(pair(s))
    mkmodule = os.path.join(REPO_ROOT, "scripts", "mkmodule")
    cmd = [sys.executable, mkmodule,
           "--public-symbols", ",".join(exports),
           "--strip-non-public-syms",
           "--build-flags=-I%s -I%s" % (nanopb_dir, out_dir),
           "--workdir", out_dir,
           "--target", args.target]
    if args.module_name:
        cmd += ["--module-name", args.module_name]
    if args.gen_c_header:
        cmd += ["--gen-c-header", "--header-path", out_dir]
    cmd += [wrapper, pb_c] + mkmodule_args
    if args.verbose:
        print(" ".join(cmd))
    if subprocess.call(cmd) != 0:
        sys.exit("error: mkmodule failed")

    # 5. Size summary (image bytes + RAM per load mode). mkmodule names the
    # .bin after the module name (--module-name or the wrapper basename)
    # unless --bin-name was passed.
    module_name = args.module_name or (proto_base + "_mod")
    bin_path = os.path.join(out_dir, module_name + ".bin")
    for i, a in enumerate(mkmodule_args):
        if a == "--bin-name" and i + 1 < len(mkmodule_args):
            bin_path = mkmodule_args[i + 1]
            break
        if a.startswith("--bin-name="):
            bin_path = a.split("=", 1)[1]
            break
    try:
        sys.path.insert(0, os.path.join(REPO_ROOT, "scripts"))
        from udynlink_parser import parse_module  # noqa: E402
        mod = parse_module(open(bin_path, "rb").read())
        h = mod.header
        lot = h.num_lot * 4
        header_off = 32 + h.num_rels * 8 + h.symt_size
        header_off = (header_off + 3) & ~3
        print("module %s: %d B image | RAM: XIP %d, COPY_TEXT_DATA %d, "
              "COPY_ALL %d" % (
                  module_name,
                  h.code_size + h.data_size + header_off,
                  lot + h.data_size + h.bss_size,
                  lot + h.code_size + h.data_size + h.bss_size,
                  lot + header_off + h.code_size + h.data_size + h.bss_size))
    except Exception:
        pass  # size summary is informational only

    print("wrote %s (%d struct(s), exports: %s)" % (
        bin_path, len(structs), ",".join(exports)))


if __name__ == "__main__":
    main()
