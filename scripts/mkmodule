#!/usr/bin/env python3

from udynlink_utils import *
from jinja2 import FileSystemLoader
from jinja2.environment import Environment
import struct
import targets
from udynlink_parser import (
    MODULE_SIGNATURE, ARCH_FLAG_NO_PROLOGUE, pack_version,
    SYM_TYPE_INTERNAL, SYM_TYPE_EXPORTED, SYM_TYPE_EXTERN,
    SYM_TYPE_MODULE_NAME, SYM_TYPE_WEAK,
    SYM_INFO_SHIFT, SYM_INFO_CODE_MASK,
    RELOC_FLAG_CODE_BASE, RELOC_FLAG_DATA_BASE,
)

sectname_code = '.text'
sectname_data = '.data'
sectname_bss = '.bss'
linker_script = os.path.join(os.path.dirname(__file__), "code_before_data.ld")

# ─── Multi-region placement (--section) ──────────────────────────────────────
# Mirrors of the image-format constants (udynlink.h / the frozen contract),
# kept local so the toolchain never imports the loader's headers.
hdr_flag_sections = 0x0001  # UDYNLINK_HDR_FLAG_SECTIONS: image carries a section table
sec_class_code, sec_class_data, sec_class_bss = 0, 1, 2
sec_flag_nocache, sec_flag_dma, sec_flag_shared = 0x01, 0x02, 0x04
sec_flag_main = 1 << 31     # section lives in the module's main RAM block
sec_main_origin = 0x02000000    # main region [0, 32 MiB); tag k starts at sec_main_origin*(k+1)
sec_prefix = ".udynlink.sec."


def parse_section_spec(spec):
    """Parse NAME[:align=N][:flags=F1,F2,...] into a placement directive.

    align (default 4, power of two) is the alignment the host must honor
    when placing the section. flags carry placement hints: the loader-defined
    NOCACHE/DMA/SHARED plus host<N> (N in 0..7) mapping to the host-reserved
    bits 15:8 of the section-table flags word.
    """
    parts = spec.split(":")
    name = parts[0]
    if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", name):
        error("--section: invalid name '%s' in '%s' (use [A-Za-z_][A-Za-z0-9_]*: it names a linker memory region)" % (name, spec))
    if name == "main":
        error("--section: name 'main' is reserved for the module's main region")
    out = {"name": name, "align": 4, "flags": 0}
    seen = set()
    for kv in parts[1:]:
        if "=" not in kv:
            error("--section: malformed option '%s' in '%s' (expected align=N or flags=F1,F2)" % (kv, spec))
        k, v = kv.split("=", 1)
        if k in seen:
            error("--section: duplicate option '%s' in '%s'" % (k, spec))
        seen.add(k)
        if k == "align":
            try:
                align = int(v, 0)
            except ValueError:
                align = None
            if align is None or align < 4 or (align & (align - 1)) != 0:
                error("--section: align must be a power of two >= 4, got '%s' in '%s'" % (v, spec))
            out["align"] = align
        elif k == "flags":
            for f in v.split(","):
                f = f.strip()
                if f.upper() == "NOCACHE":
                    out["flags"] |= sec_flag_nocache
                elif f.upper() == "DMA":
                    out["flags"] |= sec_flag_dma
                elif f.upper() == "SHARED":
                    out["flags"] |= sec_flag_shared
                else:
                    m = re.fullmatch(r"host([0-9]+)", f, re.IGNORECASE)
                    if m:
                        bit = int(m.group(1))
                        if bit > 7:
                            error("--section: host bit index %d out of range in '%s' (host<N> with N in 0..7 maps to the host flag bits 15:8)" % (bit, spec))
                        out["flags"] |= 1 << (8 + bit)
                    else:
                        error("--section: unknown flag '%s' in '%s' (valid flags: NOCACHE, DMA, SHARED, host<N> with N in 0..7)" % (f, spec))
        else:
            error("--section: unknown option '%s' in '%s' (valid options: align=N, flags=F1,F2)" % (k, spec))
    return out


def generate_sectioned_linker_script(path, args):
    """Render the multi-region linker script for a --section build.

    Replaces the fixed code_before_data.ld: one MEMORY region per declared
    tag, spaced through the flat link address space so a direct cross-region
    bl cannot be encoded (the relocation scan backs this up at link time).
    """
    env = Environment(loader=FileSystemLoader(os.path.dirname(os.path.abspath(__file__))))
    tmpl = env.get_template("linker_sections.ld.j2")
    data = tmpl.render({"sections": [
        {"name": s["name"], "origin": "0x%08X" % (sec_main_origin * (k + 1))}
        for k, s in enumerate(args.sections)]})
    with open(path, "wt") as f:
        f.write(str(data))
    debug("Generated linker script '%s'" % path, args)


################################################################################
# Compilation
################################################################################
compile_cmd = "-fPIE -msingle-pic-base -mcpu={mcpu} -mthumb{fpu}{float_abi} -fomit-frame-pointer {extra} {input} -c -o {output}"
asm_cmd = "-x assembler-with-cpp -mcpu={mcpu} -mthumb{fpu}{float_abi} {input} -c -o {output}"
link_cmd = "-mcpu={mcpu} -mthumb{fpu}{float_abi} -T {ld} -nostartfiles -nodefaultlibs -nostdlib -Wl,--unresolved-symbols=ignore-in-object-files -Wl,--emit-relocs {extra_link_flags} {input} -Wl,-e,0 -o {output}"

compile_cmd = "-ffunction-sections -fdata-sections " + compile_cmd
link_cmd = "-Wl,--gc-sections " + link_cmd

def rename_symbols(src, dest, name_map, args):
    cmdline = get_tool("objcopy")
    for n in name_map:
        cmdline = cmdline + " --redefine-sym %s=%s" % (n, name_map[n])
    cmdline = cmdline + " %s %s" % (src, dest)
    execute(cmdline, args)

def make_symbols_local(obj, symlist, args):
    cmdline = get_tool("objcopy")
    for n in symlist:
        cmdline = cmdline + " -L %s" % symlist[n]
    cmdline = cmdline + " %s %s" % (obj, obj)
    execute(cmdline, args)

def assemble(src_name, args):
    path, fname, ext = split_fname(src_name)
    objname = os.path.join(path, fname + ".o")
    asm_data = {"input": src_name, "output": objname, "mcpu": args.mcpu, "fpu": args.fpu_flag, "float_abi": args.float_abi_flag}
    debug("Assembling '%s'" % src_name, args)
    execute(get_tool("gcc") + " " + asm_cmd.format(**asm_data), args)
    return objname

sym_renames = {}
# Renames across ALL object files: the prologue-localize step in link() must
# hide every wrapped body, not just the last object file's. (Per-object the
# wrappers' bl targets stay correct; only the ELF visibility is affected.)
all_sym_renames = {}
lto_wrap_syms = []  # --lto: public function names wrapped via linker --wrap

def check_lto_object_usable(objname, args):
    """Validate an object against the --lto expectations.

    Prologue/discovery code reads the real-code symtab (STT_FUNC names), which
    only FAT LTO objects carry; slim LTO objects hide their symbol types inside
    the IR, so discovery would silently find nothing. Fully-empty TUs (feature-
    gated to nothing) emit IR metadata with an EMPTY .gnu.lto_.symtab and have
    nothing to discover, so they are fine. Also rejects -flto
    """
    has_lto_ir = has_real_code = False
    lto_symtab_bytes = 0
    with open(objname, "rb") as f:
        elf = ELFFile(f)
        for section in elf.iter_sections():
            n = section.name
            if n.startswith(".gnu.lto"):
                has_lto_ir = True
                if n.startswith(".gnu.lto_.symtab"):
                    lto_symtab_bytes = max(lto_symtab_bytes, section["sh_size"])
            elif section['sh_size'] and n.startswith((".text", ".data", ".rodata", ".bss", sec_prefix)):
                # Placement (--section) sections carry real content too: a
                # TU whose every function is placed would otherwise look
                # slim and trip the fat-LTO gate above.
                has_real_code = True
    # A genuinely slim object carries a non-empty LTO symtab (the symbol list
    # lives in the IR); an empty TU's symtab section is zero-size.
    if has_lto_ir and not has_real_code and lto_symtab_bytes > 0:
        error("--lto: object '%s' is a slim LTO object (IR without real code); "
              "symbol discovery needs -ffat-lto-objects (is it overridden in --build-flags?)" % objname)
    if not args.lto and has_lto_ir:
        error("Object '%s' contains LTO bytecode but --lto is not enabled; "
              "pass --lto instead of -flto in --build-flags" % objname)

def assign_object_paths(sources, args):
    """Give every source a unique object path under --workdir.

    Without --workdir an object lands next to its source, where the path is
    unique by construction. A flat --workdir is not: the object is named after
    the source BASENAME only, so a module whose sources share a basename (the
    zenoh module has three serial.c, three encoding.c and three liveliness.c,
    plus two string.c and two core.c) compiles them all to
    <workdir>/serial.o — each compile clobbers the previous one and the linker
    then sees a single object listed twice ("multiple definition of X ...
    first defined here" naming the same path), plus a follow-on section-type
    conflict between the clobbered objects' .text_nogc sections.

    Sources with a unique basename keep the plain <basename>.o name, so the
    common case stays readable; colliding basenames get their source directory
    appended, then a string suffix if even that is ambiguous.
    """
    args.obj_paths = {}
    if not args.workdir:
        return
    groups = {}
    for s in sources:
        groups.setdefault(split_fname(s)[1], []).append(s)
    for stem, group in groups.items():
        if len(group) == 1:
            args.obj_paths[group[0]] = os.path.join(args.workdir, stem + ".o")
            continue
        used = set()
        for i, s in enumerate(sorted(group)):
            parent = os.path.basename(os.path.dirname(os.path.abspath(s)))
            name = "%s__%s" % (stem, parent) if parent else "%s__%d" % (stem, i)
            while name in used:
                name += "_"
            used.add(name)
            args.obj_paths[s] = os.path.join(args.workdir, name + ".o")

def compile(src_name, args, public_symbols, macros=[]):
    out_dir = args.workdir if args.workdir else os.path.dirname(src_name)
    _, fname, _ = split_fname(src_name)
    main_obj = args.obj_paths.get(src_name) or os.path.join(out_dir, fname + ".o")
    object_files = []
    # Prepare compilation
    extra = "" if args.pc_rel else "-mno-pic-data-is-text-relative"
    if not args.no_long_calls:
        extra += " -mlong-calls"
    extra += " -O" + args.opt_level
    if args.lto:
        # Fat LTO objects: IR for the linker plugin (cross-TU optimization at
        # link) plus a real-code symtab so prologue/discovery code keeps working.
        extra += " -flto -ffat-lto-objects"
        # Without this, whole-program data pooling folds variables into
        # .LANCHORn symbols and GOT relocations lose their user-visible
        # names (e.g. UDYNLINK_REQUIRES() declarations stop being
        # reclassifiable as externals).
        extra += " -fno-section-anchors"
    if macros:
        extra = extra + " " + " ".join(macros)
    compile_data = {"input": src_name, "extra": extra, "output": main_obj, "mcpu": args.mcpu, "fpu": args.fpu_flag, "float_abi": args.float_abi_flag}
    # Execute compile command
    if src_name.endswith(".cpp") or src_name.endswith(".cxx"):
        compile_data["extra"] += " -fno-use-cxa-atexit"
        compile_data["extra"] += " -fno-exceptions"
        compile_data["extra"] += " -fno-rtti"
        compile_data["extra"] += " -fno-threadsafe-statics"
        # Function-local statics become a plain byte flag instead of a call
        # into __cxa_guard_acquire/release. Hosts that load C++ modules
        # therefore never need to provide __cxa_guard_* stubs. udynlink itself
        # provides no thread safety (see AGENTS.md), so cross-thread
        # interlocked initializers are the host's concern via its own
        # atomics if needed.
    # Append user-supplied --build-flags last so they land AFTER the C++
    # defaults above and can override them. GCC honors the last -f... flag
    # for toggle-style options, so --build-flags='-fthreadsafe-statics'
    # re-enables thread-safe function-local static initialization (the host
    # must then provide __cxa_guard_acquire/release/abort — see
    # docs/thread-safety.md). Same for -fexceptions, -frtti, etc.
    if args.build_flags is not None:
        compile_data["extra"] += " " + args.build_flags
    # First-class include paths (-I / --include-dir) land after --build-flags
    # so a conflicting -I in build flags wins (it is searched first); the
    # order of repeated -I flags themselves is preserved.
    if args.include_dirs:
        compile_data["extra"] += " " + " ".join("-I" + d for d in args.include_dirs)
    debug("Compiling '%s'" % src_name, args)
    execute(get_tool("gcc") + " " + compile_cmd.format(**compile_data), args)
    object_files += [main_obj]

    if src_name.endswith(".cpp") or src_name.endswith(".cxx"):
        libc_obj = os.path.join(out_dir, "cpp_init_fini.o")
        compile_data = {
            "input": os.path.dirname(os.path.abspath(__file__)) + "/cpp_init_fini.c",
            "extra": extra + " -x c ",
            "output": libc_obj,
            "mcpu": args.mcpu,
            "fpu": args.fpu_flag,
            "float_abi": args.float_abi_flag
        }
        # Execute compile command
        debug("Compiling '%s'" % src_name, args)
        execute(get_tool("gcc") + " " + compile_cmd.format(**compile_data), args)
        object_files += [libc_obj]

    # Integrity gate (both --lto and default mode): discovery and the wrapper
    # mechanism need real-code symtabs, and LTO IR must never leak in through
    # --build-flags unnoticed.
    for objname in [] + object_files:
        check_lto_object_usable(objname, args)
        if args.lto:
            # Whole-program LTO may fold weak data whose reads GCC proves
            # constant, and re-emits prevailing weak definitions as GLOBAL;
            # remember the originals to restore their binding after the link.
            if not hasattr(args, 'lto_weak_defined'):
                args.lto_weak_defined = set()
            args.lto_weak_defined.update(
                s["name"] for s in get_symbols_in_elf(objname)
                if s["name"] and s["bind"] == "STB_WEAK" and s["section"] != "SHN_UNDEF")

    # Collect exported symbols and (optionally) generate prologue wrappers
    if not args.no_prologue:
        for objname in [] + object_files:
            global_funcs = [s for s in get_public_functions_in_object(objname) if (len(public_symbols) == 0 or s in public_symbols or s == "__init_array") and not (args.strip_mangled_syms and is_cxx_mangled(s) and s not in public_symbols)]
            weak_funcs = [s for s in get_weak_functions_in_object(objname) if s in global_funcs]
            dep_syms = get_dependency_symbols_in_object(objname)
            if dep_syms:
                if not hasattr(args, 'dep_syms'):
                    args.dep_syms = set()
                args.dep_syms.update(dep_syms)
            # Wrapper co-location: each wrapper ends up bl-ing its body, and
            # a direct bl can never cross sections (tagged sections resolve
            # to unrelated addresses at load time), so a wrapper must be
            # emitted into the same section as its body. Read the body's ELF
            # section before any rename hides it; untagged bodies keep the
            # gc-protected .text_nogc.
            body_sections = {}
            if args.sections:
                obj_sects = get_sections_in_elf(objname)
                for s in get_symbols_in_elf(objname):
                    if s["name"] in global_funcs and isinstance(s["section"], int):
                        body_sections[s["name"]] = obj_sects.get(s["section"], {}).get("name", "")
            debug("Generating temporary object files with wrapped symbols '%s'" % ", ".join(global_funcs), args)
            if args.lto:
                # binutils refuses --redefine-sym on LTO IR objects, so the
                # wrapper/body split happens at link time: ld --wrap=NAME
                # redirects outside references to __wrap_NAME (the prologue
                # wrapper), which calls __real_NAME (the unrenamed IR body).
                # Defined-scope calls inside the merged LTRANS unit are not
                # redirected and call the body directly — same semantics as
                # the objcopy rename on the non-LTO path.
                for n in global_funcs:
                    check(not n.startswith(("__wrap_", "__real_")),
                          "--lto: public function '%s' collides with the reserved __wrap_/__real_ prefix; rename it or drop --lto" % n)
                lto_wrap_syms.extend(global_funcs)
                prologue_names = {("__wrap_" + n): ("__real_" + n) for n in global_funcs}
                prologue_weak = ["__wrap_" + n for n in weak_funcs]
            else:
                temp_obj = os.path.join(objname + '.temp.o')
                os.rename(objname, temp_obj)
                sym_renames.clear()
                sym_renames.update({n: get_wrapped_name(n) for n in global_funcs })
                all_sym_renames.update(sym_renames)
                if not args.no_debug:
                    print("sym_renames", to_json(sym_renames))
                rename_symbols(temp_obj, objname, sym_renames, args)
                prologue_names = sym_renames
                prologue_weak = weak_funcs
            # Generate ASM for prologue
            debug("Generating ASM file for public function prologues", args)
            loader = FileSystemLoader(os.path.dirname(os.path.abspath(__file__)))
            env = Environment(loader = loader)
            tmpl = env.get_template(args.template)
            sym_sections = {}
            for n in global_funcs:
                wrapper = ("__wrap_" + n) if args.lto else n
                sn = body_sections.get(n, "")
                # The directive operand is preformatted so every template
                # variant stays a one-line change: alloc+exec for a tagged
                # wrapper (a section unknown to GAS gets no default flags),
                # today's .text_nogc flags otherwise.
                sym_sections[wrapper] = ('%s, "ax", %%progbits' % sn) \
                    if (args.sections and sn.startswith(sec_prefix)) else '.text_nogc, "x"'
            data = tmpl.render({"sym_names": prologue_names, "weak_names": prologue_weak, "sym_sections": sym_sections})
            p_fname = os.path.join(objname + "_prologue.s")
            with open(p_fname, "wt") as f:
                f.write(str(data))
            # Assemble prologue data
            second_obj = assemble(p_fname, args)
            os.remove(p_fname)
            object_files += [second_obj]
    else:
        # No prologue: collect exported symbols so the linker can keep them alive
        for objname in [] + object_files:
            global_funcs = [s for s in get_public_functions_in_object(objname) if (len(public_symbols) == 0 or s in public_symbols or s == "__init_array") and not (args.strip_mangled_syms and is_cxx_mangled(s) and s not in public_symbols)]
            if not hasattr(args, 'exported_syms'):
                args.exported_syms = set()
            args.exported_syms.update(global_funcs)
            dep_syms = get_dependency_symbols_in_object(objname)
            if dep_syms:
                if not hasattr(args, 'dep_syms'):
                    args.dep_syms = set()
                args.dep_syms.update(dep_syms)

    if len(public_symbols) != 0:
        public_symbols.add("__init_array")

    if args.sections:
        # Placement sections must be declared: an undeclared .udynlink.sec.*
        # input section is collected by no output-section pattern and
        # --gc-sections drops it (or it lands as an orphan), so the content
        # would silently vanish from the image. Fail before the link.
        for objname in object_files:
            for meta in get_sections_in_elf(objname).values():
                nm = meta["name"]
                if nm.startswith(sec_prefix) and nm[len(sec_prefix):].split(".", 1)[0] \
                        not in [s["name"] for s in args.sections]:
                    error("--section: object '%s' places content in section '%s' but no "
                          "matching --section was declared; declare it or drop the "
                          "UDYNLINK_SECTION attribute (undeclared sections are dropped)"
                          % (objname, nm))
    return object_files

def link(objects, output, args):
    if output is None:
        path, fname, ext = split_fname(args.source[0])
        output = os.path.join(path, fname + ".elf")
    # Prepare link
    extra_link_flags = ""
    if args.no_prologue and hasattr(args, 'exported_syms') and args.exported_syms:
        for sym in sorted(args.exported_syms):
            extra_link_flags += " -Wl,--undefined=%s" % sym
    if hasattr(args, 'dep_syms') and args.dep_syms:
        for sym in sorted(args.dep_syms):
            extra_link_flags += " -Wl,--undefined=%s" % sym
    if args.lto:
        extra_link_flags += " -flto"
        # Present the link as exporting its globals: without this the plugin
        # resolution marks module symbols LDPR_PREVAILING_DEF_IRONLY and GCC
        # internalizes exported data ('D g' -> 'd g') or folds reads of weak
        # data away entirely, so hosts could no longer find/override them.
        extra_link_flags += " -Wl,--export-dynamic"
        for sym in sorted(set(lto_wrap_syms)):
            extra_link_flags += " -Wl,--wrap=%s" % sym
    link_data = {"input": " ".join(objects), "output": output, "ld": getattr(args, 'linker_script', None) or linker_script, "mcpu": args.mcpu, "fpu": args.fpu_flag, "float_abi": args.float_abi_flag, "extra_link_flags": extra_link_flags}
    debug("Linking (%s -> %s)" % (" + ".join(objects), output), args)
    execute(get_tool("gcc") + " " + link_cmd.format(**link_data), args)
    if args.lto and lto_wrap_syms:
        # Two objcopy passes on the final (real-code) ELF: binutils applies
        # --redefine-sym and -L inside one invocation in an order not
        # guaranteed across versions, so localize strictly after renaming.
        # Pass 1 hides the IR-derived bodies under a collision-proof name.
        hidden = {n: get_wrapped_name(n) for n in sorted(set(lto_wrap_syms))}
        cmdline = get_tool("objcopy")
        for n, h in hidden.items():
            cmdline += " --redefine-sym %s=%s" % (n, h)
        execute(cmdline + " " + output + " " + output, args)
        # Pass 2 promotes the --wrap wrappers to the public names and makes
        # the hidden bodies local (nameless INTERNAL entries in the image).
        cmdline = get_tool("objcopy")
        for n, h in hidden.items():
            cmdline += " --redefine-sym __wrap_%s=%s -L %s" % (n, n, h)
        execute(cmdline + " " + output + " " + output, args)
    if args.lto and getattr(args, 'lto_weak_defined', None):
        # Pass 3: GCC's LTRANS re-emits prevailing weak definitions as
        # GLOBAL; weaken them back so the image classifies them as WEAK and
        # the loader keeps the host-override path alive.
        cmdline = get_tool("objcopy")
        for n in sorted(args.lto_weak_defined):
            cmdline += " -W %s" % n
        execute(cmdline + " " + output + " " + output, args)
        # paranoia gate: if whole-program opt still folded a weak symbol
        # away, the host override point is gone — say so loudly.
        final_syms = {s["name"] for s in get_symbols_in_elf(output)}
        for n in sorted(args.lto_weak_defined):
            if n not in final_syms:
                warn("--lto: weak symbol '%s' no longer exists in the linked "
                     "module and cannot be overridden by the host (declare it "
                     "volatile, or build without --lto)" % n)
    else:
        # Change visibility of wrapped symbols to "local"
        debug("Changing visiblity of wrapped symbols to 'local' in %s" % output, args)
        make_symbols_local(output, all_sym_renames, args)

def get_sections_in_elf(obj):
    """Index -> {'name', 'addralign'} for every section in the ELF.

    Diagnostics need the reverse of get_section_in_elf: symbols reference
    sections by st_shndx index, so the unknown-section error has to name a
    section by index and the alignment warning reads sh_addralign, neither of
    which that helper carries.
    """
    sects = {}
    with open(obj, "rb") as f:
        elf = ELFFile(f)
        for i, section in enumerate(elf.iter_sections()):
            # sh_addralign 0 means "no alignment", same as 1; normalize so the
            # 4-byte-guarantee comparison in process() needs no special case.
            sects[i] = {"name": section.name, "addralign": max(int(section["sh_addralign"]), 1),
                        "sh_type": section["sh_type"], "sh_flags": int(section["sh_flags"])}
    return sects

def process(output, args):
    # Read actual data and verify proper section placement
    set_debug_col()
    debug("%s Reading relevant sections %s" % ('-' * 10, '-' * 10), args)
    # Code section
    crt_off = 0
    sect_idx_mapping = {}
    secinfo = get_sections_in_elf(output)
    cs = get_section_in_elf(output, sectname_code)
    debug("Read section '%s' of size %d" % (sectname_code, cs["size"]), args)
    check(cs["size"] % 4 == 0, "Length of section '%s' is not a multiple of 4" % sectname_code)
    check(cs["addr"] == 0, "Section '%s' doesn't start at address 0" % sectname_code)
    code_sect = bytearray(cs["data"])
    crt_off += cs["size"]
    sect_idx_mapping[cs["index"]] = sectname_code
    # Data section
    ds = get_section_in_elf(output, sectname_data)
    debug("Read section '%s' of size %d" % (sectname_data, ds["size"]), args)
    check(ds["size"] % 4 == 0, "Length of section '%s' is not a multiple of 4" % sectname_data)
    check(ds["addr"] >= crt_off, "Section '%s' doesn't begin after section '%s'" % (sectname_data, sectname_code))
    data_sect = ds["data"]
    # Mirror the .data->.bss gap padding below: a member with a strict
    # alignment raises the packed .data's sh_addralign, so the linker starts
    # the section after a gap. Data symbol values and ABS32 relocation
    # offsets are linker addresses that span the gap (st_value minus
    # len(code_sect)), so the gap must be padded into the packed .data for
    # every such address to land inside the arena. The loader still places
    # the blob at a merely 4-byte-aligned address — see the alignment warning
    # below.
    data_gap = ds["addr"] - crt_off
    check(data_gap % 4 == 0, ".data alignment gap '%d' is not a multiple of 4" % data_gap)
    if data_gap > 0:
        debug("Padding %d bytes of .text->.data alignment gap into the RAM arena" % data_gap, args)
        data_sect = bytes(data_gap) + data_sect
    crt_off += len(data_sect)
    sect_idx_mapping[ds["index"]] = sectname_data
    # BSS section
    bs = get_section_in_elf(output, sectname_bss)
    debug("Read section '%s' of size %d" % (sectname_bss, bs["size"]), args)
    check(bs["size"] % 4 == 0, "Length of section '%s' is not a multiple of 4" % sectname_bss)
    check(bs["addr"] >= crt_off, "Section '%s' doesn't begin after section '%s'" % (sectname_bss, sectname_data))
    bss_sect = bs["data"]
    # The loader places .bss immediately after .data in the RAM arena, but
    # symbol values are .data-relative LINKER addresses — they include the
    # alignment gap between .data and .bss (e.g. .bss 32-byte aligned). Pad
    # the packed .bss with that gap so the arena covers every .bss byte the
    # symbols can reach; otherwise the tail of .bss writes past the arena
    # into whatever block the allocator placed next (e.g. the task stack).
    bss_gap = bs["addr"] - (ds["addr"] + ds["size"])
    check(bss_gap % 4 == 0, ".bss alignment gap '%d' is not a multiple of 4" % bss_gap)
    if bss_gap > 0:
        debug("Padding %d bytes of .data->.bss alignment gap into the RAM arena" % bss_gap, args)
        bss_sect = bytes(bss_gap) + bss_sect
    sect_idx_mapping[bs["index"]] = sectname_bss
    # Add a special key for undefined symbols
    sect_idx_mapping["SHN_UNDEF"] = None
    # ── Tagged (--section) placement sections ────────────────────────────
    # Tagged sections keep their ELF link VAs: the main sections link at
    # 0/… and tag k at 0x02000000*(k+1), so the flat VA map stays
    # unambiguous and the loader resolves runtime(va) per section entry.
    sectioned = bool(args.sections)
    section_entries = []
    code_section_names = {sectname_code}
    # Per-section packed payload buffers with their VA spans: relocation
    # sites (literal pools) live inside the payload of the section they
    # belong to — tagged code sections carry their own pools — so site
    # patching must never assume the main .text/.data pair. The main .data
    # span starts at VA code_size because its packed blob carries the
    # leading alignment gap; .bss has no payload to patch.
    payload_bufs = [
        (cs["addr"], cs["addr"] + len(code_sect), sectname_code, code_sect),
        (ds["addr"] - data_gap, ds["addr"] - data_gap + len(data_sect), sectname_data, bytearray(data_sect)),
        (bs["addr"], bs["addr"] + len(bss_sect), sectname_bss, None),
    ]
    if sectioned:
        def _sec_class(sh_type, sh_flags):
            # Class is derived from what the section contains: zero-init
            # only -> BSS, executable -> CODE, otherwise DATA.
            if sh_type == "SHT_NOBITS":
                return sec_class_bss
            return sec_class_code if (sh_flags & 0x4) else sec_class_data  # SHF_EXECINSTR
        # The main sections always own the three lowest VAs (main region
        # [0, 32 MiB) vs tags at 0x02000000*(k+1)), so they keep indices
        # 0/1/2 in the VA-sorted table. Entries carry the packed blob sizes
        # (alignment gaps included) and the section's ELF link VA; the
        # loader aligns each base inside the RAM block, which is what makes
        # member alignment real for the main sections of tagged modules.
        section_entries.append({"name": None, "va": cs["addr"], "size": len(code_sect),
                                "align": max(4, secinfo[cs["index"]]["addralign"]),
                                "class": sec_class_code, "flags": sec_flag_main, "payload": code_sect})
        section_entries.append({"name": None, "va": ds["addr"], "size": len(data_sect),
                                "align": max(4, secinfo[ds["index"]]["addralign"]),
                                "class": sec_class_data, "flags": sec_flag_main, "payload": data_sect})
        section_entries.append({"name": None, "va": bs["addr"], "size": len(bss_sect),
                                "align": max(4, secinfo[bs["index"]]["addralign"]),
                                "class": sec_class_bss, "flags": sec_flag_main, "payload": None})
        for spec in args.sections:
            snm = sec_prefix + spec["name"]
            if snm not in [m["name"] for m in secinfo.values()]:
                warn("--section '%s' declared but nothing was placed in '%s'; the section "
                     "is omitted from the image" % (spec["name"], snm))
                continue
            tsec = get_section_in_elf(output, snm)
            check(tsec["size"] % 4 == 0, "Length of section '%s' is not a multiple of 4" % snm)
            meta = secinfo[tsec["index"]]
            elf_align = max(4, meta["addralign"])
            if elf_align > spec["align"]:
                warn("--section '%s': section content requires %d-byte alignment (e.g. "
                     "UDYNLINK_SECTION_ALIGNED), raising the declared align=%d to %d"
                     % (spec["name"], elf_align, spec["align"], elf_align))
            cls = _sec_class(meta["sh_type"], meta["sh_flags"])
            section_entries.append({"name": spec["name"], "va": tsec["addr"], "size": tsec["size"],
                                    "align": max(spec["align"], elf_align), "class": cls,
                                    "flags": spec["flags"], "payload": tsec["data"]})
            sect_idx_mapping[tsec["index"]] = snm
            payload_bufs.append((tsec["addr"], tsec["addr"] + tsec["size"], snm,
                                 None if cls == sec_class_bss else bytearray(tsec["data"])))
            if cls == sec_class_code:
                code_section_names.add(snm)

    def _site_section(addr):
        # Output section containing a relocation site, or None when the
        # site lives outside the packed sections (never a call site).
        for lo, hi, nm, _buf in payload_bufs:
            if lo <= addr < hi:
                return nm
        return None

    def _payload_at(addr):
        # (writable payload buffer, byte index) holding the word at the ELF
        # VA, or (None, 0) when the site is not shipped in any payload
        # (e.g. .got: GOT sites are read from the ELF but never patched).
        # Untagged builds have a single code payload whose VAs equal byte
        # offsets, so this reduces to today's direct code_sect indexing.
        for lo, hi, _nm, buf in payload_bufs:
            if buf is not None and lo <= addr < hi:
                return buf, addr - lo
        return None, 0

    # Build the list of exported and unknown symbols
    set_debug_col('cyan')
    debug("%s Examining symbol table %s" % ('-' * 10, '-' * 10), args)
    syms = get_symbols_in_elf(output)
    rels = get_relocations_in_elf(output)
    print_list(syms,"syms   :", args)
    # The loader guarantees only 4-byte alignment for module data (the RAM
    # arena base is 4-byte aligned and .data/.bss follow it unaligned), so a
    # member that raised the packed .data/.bss sh_addralign above 4 will not
    # get that alignment at runtime. Warn once so aligned(N>4) is a visible
    # no-op instead of a silent misalignment.
    over = []
    for sect in (ds, bs):
        align = secinfo[sect["index"]]["addralign"]
        if align <= 4:
            continue
        hits = [sd for sd in syms if sd["section"] == sect["index"] and sd["name"]
                and (sd["value"] - sect["addr"]) % align == 0]
        names = ([sd["name"] for sd in hits if sd["type"] == "STT_OBJECT"]
                 or [sd["name"] for sd in hits])[:2]
        over.append("%s requires %d-byte alignment%s" % (
            sect["name"], align,
            (" (symbol%s %s)" % ("s" if len(names) > 1 else "",
             ", ".join("'%s'" % n for n in names))) if names else ""))
    if over:
        warn("%s, but the udynlink loader guarantees only 4-byte alignment for module "
             "data: __attribute__((aligned(N))) with N > 4 on module data is not honored "
             "at runtime, the data is placed at a 4-byte-aligned arena offset and code "
             "relying on the stricter alignment will misbehave. Put the data in a declared "
             "placement section instead: --section <name> plus UDYNLINK_SECTION_ALIGNED("
             "\"<name>\", N) from udynlink/udynlink_section.h gets the alignment honored "
             "(the host places the section at a suitably aligned address)." % " and ".join(over))
    # Symbols are identified by (symtab section index, symbol index) — NOT by
    # name.  GCC's local constant-pool labels (.LC0, .LC1, ...) are reused in
    # every translation unit of a multi-TU module: they share a name but have
    # distinct st_value/st_shndx.  Keying by name would collapse them and make
    # every reference resolve to the last-written symbol's address, corrupting
    # PIC code at runtime.  See the ``.LC0`` collision regression test.
    def _sym_key(sd):
        """Unique identity of a symbol: its (symtab section, symbol index)."""
        return (sd["symtab"], sd["idx"])
    sym_data = {_sym_key(sd): sd for sd in syms}
    sym_map = {}
    seen_nonlocal_names = set()
    for sd in syms:
        name = sd["name"]
        if not name or name == "$t" or name == "$d":
            continue
        key = _sym_key(sd)
        if sd["bind"] == "STB_GLOBAL":
            if name in seen_nonlocal_names:
                error("Duplicate global symbol '%s' in module" % name)
            seen_nonlocal_names.add(name)
            defined = sd["section"] != "SHN_UNDEF"
            if defined:
                sym_map[key] = "exported"
                debug("Added symbol '%s' (%s) to list of exported symbols" % (name, sd["type"]), args)
            else:
                sym_map[key] = "external"
                debug("Added symbol '%s' (%s) to list of external symbols" % (name, sd["type"]), args)
        elif sd["bind"] == "STB_WEAK":
            # Defined weak symbols are classified as "weak" so the loader can
            # apply the module's own address as a default and optionally patch
            # it with a host override.  Undefined weak symbols are treated as
            # "external" (still fail if unresolved — unlike ELF they do not
            # silently resolve to NULL).
            if name in seen_nonlocal_names:
                error("Duplicate weak symbol '%s' in module" % name)
            seen_nonlocal_names.add(name)
            defined = sd["section"] != "SHN_UNDEF"
            if defined:
                sym_map[key] = "weak"
                debug("Added symbol '%s' (%s) to list of weak symbols" % (name, sd["type"]), args)
            else:
                sym_map[key] = "external"
                debug("Added symbol '%s' (%s) to list of external symbols" % (name, sd["type"]), args)
        else:
            if sd["type"] == "STT_FILE":
                continue
            sym_map[key] = "local"
            debug("Added symbol '%s' (%s) to list of local symbols" % (name, sd["type"]), args)
    def _key_name(key):
        return sym_data[key]["name"]
    print_list([_key_name(k) for k in sym_map if sym_map[k] == "exported"], "Exported :", args)
    print_list([_key_name(k) for k in sym_map if sym_map[k] == "external"], "External :", args)
    print_list([_key_name(k) for k in sym_map if sym_map[k] == "weak"],   "Weak     :", args)
    print_list([_key_name(k) for k in sym_map if sym_map[k] == "local"],   "Locals   :", args)

    # Reclassify .udynlink.mod.requires.* symbols as external.
    # These are emitted by UDYNLINK_REQUIRES() as definitions with value 0
    # (to survive --gc-sections) but semantically they are dependency
    # declarations that must be resolved by the host at load time.
    for key in list(sym_map.keys()):
        name = sym_data[key]["name"]
        if name.startswith(".udynlink.mod.requires.") and sym_map[key] == "exported":
            debug("Reclassified dependency symbol '%s' from exported to external" % name, args)
            sym_map[key] = "external"
    # Detect and omit empty init-array sentinel symbols from the symbol table.
    # These four symbols are emitted by the linker script even for C modules
    # with no constructors.  When they all have size 0 and identical addresses
    # (start == end) they serve no purpose and waste ~100 bytes of symbol table.
    # We keep them in sym_map so relocation processing doesn't crash, but skip
    # them when building slist_all unless they are actually referenced by a
    # relocation (e.g. in a C++ module that uses cpp_init_fini.c).
    init_array_names = {
        "__init_array_start",
        "__init_array_end",
        "__preinit_array_start",
        "__preinit_array_end",
    }
    empty_init_keys = set()
    init_syms = {}
    for sd in syms:
        if sd["name"] in init_array_names and sd["name"] not in init_syms:
            init_syms[sd["name"]] = sd
    if init_array_names <= set(init_syms):
        # All four exist. Check criteria for "empty array".
        all_empty = True
        common_value = None
        for n in init_array_names:
            d = init_syms[n]
            if d["bind"] != "STB_GLOBAL" or d["type"] != "STT_NOTYPE" or d["size"] != 0:
                all_empty = False
                break
            if common_value is None:
                common_value = d["value"]
            elif d["value"] != common_value:
                all_empty = False
                break
        if all_empty:
            empty_init_keys = {_sym_key(init_syms[n]) for n in init_array_names}
            debug("Detected empty init-array sentinels; will omit from symbol table unless referenced by relocations", args)

    # ── C++ symbol-table filtering (opt-in) ────────────────────────────────
    # Each enabled flag demotes eligible *defined* symbols (currently
    # 'exported' or 'weak') to 'local' (nameless INTERNAL). They keep their
    # value so relocations resolve, but lose their name (and, for weaks, the
    # host-override path). Externs, the module name, dependency declarations,
    # and anything in --public-symbols are never demoted.
    def _should_demote(sd, sym_class, public_symbols, args):
        if sym_class not in ("exported", "weak"):
            return False
        name = sd["name"]
        if name in public_symbols:
            return False
        if args.strip_hidden_syms and sd["visibility"] in ("STV_HIDDEN", "STV_INTERNAL"):
            return True
        if args.strip_non_public_syms and len(public_symbols) > 0:
            return True
        if args.strip_mangled_syms and is_cxx_mangled(name):
            return True
        if args.strip_weak_sym_names and sym_class == "weak":
            return True
        return False

    demoted = 0
    for key in list(sym_map.keys()):
        cls = sym_map[key]
        if _should_demote(sym_data[key], cls, public_symbols, args):
            debug("Filter: demoting '%s' (%s) to internal (nameless)" % (sym_data[key]["name"], cls), args)
            sym_map[key] = "local"
            demoted += 1
    debug("Filter: demoted %d defined symbol(s) to internal" % demoted, args)

    def _reloc_key(r):
        return (r["symtab"], r["sym_idx"])

    # Process relocations
    set_debug_col('yellow')
    debug("%s Examining relocations %s" % ('-' * 10, '-' * 10), args)
    local_relocs, foreign_relocs, rlist, ignored = [], [], [], {}
    for r in rels:
        name, t = r["name"], r["type"]
        sd = sym_data.get(_reloc_key(r))
        if sd is None:
            if not ignored.get(name, False):
                warn("Ingoring unknown symbol '%s' in relocation list" % name)
                ignored[name] = True
            continue
        key = _reloc_key(r)
        offset, value = r["offset"], sd["value"]
        if t == "R_ARM_THM_CALL" or t == "R_ARM_THM_JUMP24":  # PC-relative, safe to ignore
            if sectioned:
                # A direct branch bakes in a PC-relative offset, but tagged
                # sections resolve to unrelated addresses at load time (the
                # link-space spacing only makes the accidental case a link
                # error for in-range encodings). Long calls (the default)
                # route through the LOT and are placement-agnostic.
                src = _site_section(offset)
                tgt = sect_idx_mapping.get(sd["section"])
                if src is not None and tgt != src:
                    error("--section: direct %s in section '%s' targets '%s' (symbol '%s'); "
                          "a direct call cannot cross placement sections. Keep the callee in "
                          "the same --section or drop the placement attribute."
                          % (t, src, tgt or "<unplaced section>", name))
            debug("Ignoring relocation R_ARM_THM_CALL for symbol '%s' of type '%s'" % (name, sd["type"]), args)
            continue
        elif t == "R_ARM_GOT_BREL":
            if sym_map[key] == "local" or sym_map[key] == "exported" or sym_map[key] == "weak":
                debug("Found local relocation for symbol '%s' (offset is %X, value is %x)" % (name, offset, value), args)
                local_relocs.append((key, name, offset, value))
            elif sym_map[key] == "external":
                debug("Found foreign relocation for symbol '%s' (offset is %X)" % (name, offset), args)
                foreign_relocs.append((key, name, offset, value))
            else:
                error("Unknown relocation '%s' for symbol '%s'" % (t, name))
            rlist.append(r)
        elif t != "R_ARM_ABS32" and t != "R_ARM_TARGET1":
            error("Unknown relocation type '%s' for symbol '%s'" % (t, name))
    # Establish a mapping between each distinct symbol and its LOT slot.
    # Identity is the symbol key (symtab, idx), so two same-named local
    # symbols (e.g. .LC0 from different TUs) get distinct LOT slots.
    reloc_key_to_lot, lot_entries = {}, 0
    for r in rlist:
        key = _reloc_key(r)
        if key not in reloc_key_to_lot:
            reloc_key_to_lot[key] = lot_entries
            lot_entries += 1

    # referenced_keys: symbols referenced by any relocation that must appear
    # in the emitted symbol table (GOT_BREL finds referenced by rlist above;
    # ABS32 to a named non-.data symbol also needs a symt entry).
    referenced_keys = set(reloc_key_to_lot)

    # Data relocations deal with R_ARM_ABS32 relocs
    delta_off, data_relocs = lot_entries, []
    for r in rels:
        name, t = r["name"], r["type"]
        sd = sym_data.get(_reloc_key(r))
        if sd is None:
            if not ignored.get(name, False):
                warn("Ignoring unknown symbol '%s' in relocation list" % name)
                ignored[name] = True
            continue
        key = _reloc_key(r)
        if t == "R_ARM_ABS32" or t == "R_ARM_TARGET1":
            offset, value = r["offset"], r["value"]
            check(offset % 4 == 0, "%s offset mod 4 '%x' is not a multiple of 4" % (name, offset))
            check((offset - len(code_sect)) % 4 == 0, "%s code_sect mod 4 '%x-%x' is not a multiple of 4" % (name, offset, len(code_sect)))
            offset = int((offset - len(code_sect)) / 4)
            check(offset >= 0, "Offset of R_ARM_ABS32 symbols '%s' should be positive or 0!" % name)
            data_relocs.append((key, name, delta_off + offset, value))
            debug("Found data relocation for symbol '%s' (offset is %X, value is %x)" % (name, delta_off + offset, value), args)
            if name != ".data":
                referenced_keys.add(key)
    print_list([r["name"] for r in rlist], "Final LOT relocation list:", args)
    print_list([rl[1] for rl in data_relocs], "Final data relocation list:", args)
    debug("Symbol positions in LOT: " + str({(sym_data[k]["name"], k): v for k, v in reloc_key_to_lot.items()}), args)

    # Apply initial LOT relocations in .code
    set_debug_col('green')
    debug("%s Applying relocations according to symbol offsets in LOT %s" % ('-' * 10, '-' * 10), args)
    # Apply local relocations: for each reloc, patch the binary to refer to the corresponding
    # offset in the LOT
    for r in local_relocs + foreign_relocs:
        key, name, offset, value = r
        # A tagged code section carries its own literal pools, so the site
        # can live in any shipped payload — resolve it through the per-
        # section buffers instead of assuming the packed main .text.
        buf, buf_off = _payload_at(offset)
        check(buf is not None, "Relocation site 0x%08X for symbol '%s' is not inside any packed section payload" % (offset, name))
        old = struct.unpack_from("<I", buf, buf_off)[0]
        new = reloc_key_to_lot[key] * 4
        struct.pack_into("<I", buf, buf_off, new)
        debug("Patched location %08X (old = %08X, new = %08X) for symbol '%s'" % (offset, old, new, name), args)
    # +--------------+--------------+---------------------------------------+
    # | Field name   | Field size   | Meaning                               |
    # +--------------+--------------+---------------------------------------+
    # | sign         | 4            | Signature for module (always 'UDLM')  |
    # | totlot       | 2            | Number of LOT entries                 |
    # | totrels      | 2            | Total number of relocations           |
    # | symtsize     | 4            | Size of symbol table, bytes (align 4)|
    # | codesize     | 4            | Size of code, bytes (align 4)         |
    # | datasize     | 4            | Size of data, bytes (align 4)         |
    # | bsssize      | 4            | Size of bss, bytes (align 4)          |
    # | <rels>       | 8*totrels    | Relocations                           |
    # | <symt>       | symtsize     | Symbol table                          |
    # +--------------+--------------+---------------------------------------+
    # .code + .data (if any) follows immediately after this header
    #
    # Each local relocation is a (LOT offset, addend) pair
    # Each foreign relocation is a (LOT offset, symt offset) pair
    # The actual image comes after the data: code first, then .data (if any)

    set_debug_col('magenta')
    debug("%s Building image %s" % ('-' * 10, '-' * 10), args)
    img = bytearray(MODULE_SIGNATURE)  # Signature (4b)
    # The first entry in the symbol table is always the module name
    slist_all = [k for k in sym_map
                 if ((k in referenced_keys) or sym_map[k] == "external"
                     or sym_map[k] == "exported" or sym_map[k] == "weak")
                 and not (k in empty_init_keys and k not in referenced_keys)]
    img += struct.pack("<H", args.mod_version_val)    # Module ABI version (2b)
    img += struct.pack("<H", args.udynlink_version_val)  # Loader ABI version (2b)
    img += struct.pack("<H", args.arch_tag_val)        # Architecture tag (2b)
    img += struct.pack("<H", lot_entries)              # LOT size (2b)

    # Build symbol list: module name at index 0, then named symbols sorted
    # lexicographically for O(log n) binary search in udynlink_lookup_symbol,
    # then local (nameless) symbols at the end.
    named = sorted([k for k in slist_all if sym_map[k] != "local"], key=_key_name)
    local = [k for k in slist_all if sym_map[k] == "local"]
    slist = [args.name] + named + local
    symt_mapping = {k: i for i, k in enumerate(slist)}
    # The image can only carry .text/.data/.bss, so a symbol in any other
    # section has no slot to land in. Fail with the offending section and
    # symbol names instead of the bare KeyError the packed-section lookup
    # below would raise.
    unplaced = {}
    for s in slist[1:]:
        sd = sym_data[s]
        sect = sd["section"]
        if sect in sect_idx_mapping:
            continue
        if isinstance(sect, int):
            label = "section '%s'" % (secinfo.get(sect, {}).get("name") or ("index %d" % sect))
        elif sect == "SHN_ABS":
            label = "absolute address (SHN_ABS)"
        elif sect == "SHN_COMMON":
            label = "common block (SHN_COMMON)"
        else:
            label = "special section value '%s'" % sect
        unplaced.setdefault(label, []).append(sd["name"])
    if unplaced:
        error("The module image packs only the '.text', '.data' and '.bss' sections "
              "(the linker script folds their input variants into them: .text*, "
              ".rodata*, .text_nogc, .data*, .sdata, .bss*, .sbss, COMMON, "
              ".bss.udynlink_thunk_pool), but these symbols cannot be placed into it: "
              "%s. Objects or functions tagged into other sections "
              "(__attribute__((section(\"...\"))) with a custom section name) are not "
              "supported; place them in one of the packed sections instead."
              % "; ".join("%s: symbol%s %s" % (label, "s" if len(ns) > 1 else "",
                          ", ".join("'%s'" % n for n in ns))
                          for label, ns in unplaced.items()))

    relocated = {}
    realocs, total_relocs = bytearray(), 0

    # Process dependency relocations (.udynlink.mod.requires.*) before
    # all others so that the core loader resolves them first, allowing
    # the host's dependency system to auto-load required modules before
    # it processes function EXTERN relocations for the same module.
    dep_prefix = lambda r: (0 if r[1].startswith(".udynlink.mod.requires.") else 1)
    ordered_relocs = sorted(local_relocs + foreign_relocs + data_relocs, key=dep_prefix)

    for r in ordered_relocs:
        key, name, offset, value = r
        if name == ".text":
            value = RELOC_FLAG_CODE_BASE | value #flag -> not a symt index
        elif name == ".data":
            # R_ARM_ABS32 data relocation
            # *offset += &data - value
            data_offset = (offset - delta_off) * 4
            value = RELOC_FLAG_DATA_BASE | value #flag -> not a symt index
        else:
            if r not in data_relocs:
                offset = reloc_key_to_lot[key]
            value = symt_mapping[key]
            if relocated.get(f"{key}{offset}{value}", False):
                continue

        debug("Relocation (%s) type: %s { lot: 0x%08X, symt: 0x%08X }  written." % (
            name,
            "foreign" if r in foreign_relocs else "local", offset, value), args)
        relocated[f"{key}{offset}{value}"] = True
        realocs += struct.pack("<II", offset, value)
        total_relocs += 1
    debug("== RelocationTable, entries: %d" % total_relocs, args)
    img += struct.pack("<H", total_relocs)  # Total number of relocations (2b)
    if sectioned:
        # Flags word (was reserved): bit 0 = section table present, bits
        # 7:1 = section count. The count lives in the header so pre-load
        # size accounting stays deref-free; 6 bits cap it at 63 entries.
        check(len(section_entries) <= 63,
              "too many placement sections (%d): the header carries at most 63" % len(section_entries))
        img += struct.pack("<H", hdr_flag_sections | (len(section_entries) << 1))
    else:
        img += struct.pack("<H", 0)  # Reserved (2b, was num_deps)

    def _sym_name(s):
        return args.name if s == args.name else sym_data[s]["name"]

    symt_len = len(slist) * 8 + 4 # 2 4-byte entry for each symbol: (offset to name, offset in image) + initial word which is the number of entries
    for i, s in enumerate(slist):
        if i == 0 or sym_map[s] != "local":
            symt_len += len(_sym_name(s)) + 1

    # Section names are interned into the same string pool (no second pool):
    # the walk above placed every named symbol at a known offset; tagged
    # names continue that walk, deduplicating against identical symbol
    # names, so symt_size covers them and the loader finds each name at its
    # offset in the section table.
    sec_name_pool = {}
    sec_names_appended = []
    if sectioned:
        off = len(slist) * 8 + 4
        for i, s in enumerate(slist):
            if i == 0 or sym_map[s] != "local":
                nm = args.name if i == 0 else sym_data[s]["name"]
                if nm not in sec_name_pool:
                    sec_name_pool[nm] = off
                    off += len(nm) + 1
        for e in section_entries:
            if e["name"] is not None and e["name"] not in sec_name_pool:
                sec_name_pool[e["name"]] = off
                sec_names_appended.append(e["name"])
                off += len(e["name"]) + 1
        symt_len = round_to(off, 4)
    else:
        symt_len = round_to(symt_len, 4)
    img += struct.pack("<I", symt_len)  # Size of symbol table in bytes (4b)
    img += struct.pack("<I", len(code_sect))  # Size of code section (4b)
    img += struct.pack("<I", len(data_sect))  # Size of data section (4b)
    img += struct.pack("<I", len(bss_sect))  # Size of bss section (4b)
    # Write relocations: (lot off, symy off) pairs
    img += realocs

    debug("== SymbolTable, entries: (%d), bytes %d" % (len(slist), symt_len), args)
    # Write actual symbol table
    off = len(slist) * 8 + 4
    # First word is the numer of entries
    img += struct.pack("<I", len(slist))
    for i, s in enumerate(slist):
        debug_hint = ""
        if i > 0:  # regular symbol (not the module name).
            # The "offset" part of the symbol def has only 27 bits usable as offset
            # The most signifcant 5 bits encode data about the symbol itself:
            #     31: always 0, except for the last entry marker (which is 0xFFFFFFFF)
            #     30: 1 if in code section, 0 if in data section
            #     29-27: type (0 = local, 1 = exported, 2 = external, 3 = module name, 4 = weak). Local symbols do NOT have a name (offset is 0).
            sd = sym_data[s]
            name = sd["name"]
            defined_in_code = sect_idx_mapping[sd["section"]] in code_section_names
            if sym_map[s] == "local":
                type_data = SYM_TYPE_INTERNAL
            elif sym_map[s] == "exported":
                type_data = SYM_TYPE_EXPORTED
            elif sym_map[s] == "weak":
                type_data = SYM_TYPE_WEAK
            else:  # external
                type_data = SYM_TYPE_EXTERN
            type_data |= SYM_INFO_CODE_MASK if defined_in_code else 0
            val = sd["value"]
            # Sectioned images keep the raw ELF link VA (resolution goes
            # through the section table's flat VA map); untagged images
            # offset data values into the packed arena exactly as before.
            val_offset = 0 if (sectioned or sym_map[s] == "external" or defined_in_code) else len(code_sect)
            # Symbols that are not in the code section (and are defined in the module) will have their value offseted with the
            # start of the .data section in the image
            debug_hint = "type: %s, " % sym_map[s]
            if val_offset:
                debug_hint += "Offset by -0x%08X bytes from value 0x%08X" % (val_offset, val)
            val = val - val_offset
            s_off = (off if sym_map[s] != "local" else 0) | (type_data << SYM_INFO_SHIFT)
        else:  # module name
            name = args.name
            val, s_off = 0, (SYM_TYPE_MODULE_NAME << SYM_INFO_SHIFT) | off
        img += struct.pack("<II", s_off, val)
        debug("%02d: Symbol '%s', %s { offset: 0x%08X, value 0x%08X }" %
              (i, name, debug_hint, s_off, val), args)
        if i == 0 or sym_map[s] != "local":  # local symbols don't have a name in the offset table
            off = off + len(name) + 1
    # Pass 2: write actual symbols
    for i, s in enumerate(slist):
        if i == 0 or sym_map[s] != "local":
            img += (_sym_name(s) + '\0').encode('utf-8')
    if sectioned:
        # The interned section names are part of the pool: append them here
        # (walk order == assigned offsets) so the pool bytes match symt_size
        # and the loader reads each name at its table offset.
        for nm in sec_names_appended:
            img += (nm + '\0').encode('utf-8')
    # Round to a multiple of 4
    if len(img) % 4 > 0:
        img += ('\0' * (4 - len(img) % 4)).encode('utf-8')
    if sectioned:
        # Section table, entries only (the count rides in the header flags
        # word), sorted by VA — the main sections keep indices 0/1/2 —
        # then payloads in the same VA order, skipping BSS: nothing to load
        # for a zero-init section. This keeps [text][data] at the head of
        # the payload area, so data_offset == code_offset + code_size holds.
        section_entries.sort(key=lambda e: e["va"])
        for e in section_entries:
            name_off = 0 if e["name"] is None else sec_name_pool[e["name"]]
            img += struct.pack("<IIIIII", name_off, e["va"], e["size"], e["align"],
                               e["class"], e["flags"])
            debug("Section '%s': { name_off 0x%X, va 0x%08X, size %d, align %d, class %d, flags 0x%08X }" %
                  (e["name"] or "<main>", name_off, e["va"], e["size"], e["align"], e["class"], e["flags"]), args)
        for e in section_entries:
            if e["class"] != sec_class_bss:
                img += e["payload"]
    else:
        # And finally append the code
        img = img + code_sect + data_sect
    bin_name = args.bin_name
    with open(bin_name, "wb") as f:
        f.write(img)
    print("Image written to '%s'." % bin_name)
    set_debug_col()
    return bin_name

def disasm(output, args):
    if args.disasm:
        execute(get_tool("objdump") + " -D -j .text -w -z %s" % output, args)

def gen_c_header(bin_name, header_path, args):
    path, fname, ext = split_fname(bin_name)
    header_name = os.path.join(header_path, fname + "_module_data.h")
    debug("Generating header '%s' from binary '%s'" % (bin_name, header_name), args)
    with open(bin_name, "rb") as f:
        bin_data = f.read()
    with open(header_name, "wt") as f:
        f.write("// Automatically generated header file\n\n")
        f.write("static const unsigned char %s_module_data[] = {\n    " % fname)
        cnt = 0
        for idx, c in enumerate(bin_data):
            f.write("0x%02X" % c)
            if idx < len(bin_data) - 1:
                f.write(",")
                cnt += 1
                f.write("\n    " if cnt % 32 == 0 else " ")
        f.write("\n};\n")

################################################################################
# Entry point
################################################################################

parser = get_arg_parser('Compilation script')
parser.add_argument('--disasm', dest="disasm", action="store_true", help="Show disassembly (default: false)")
parser.add_argument('--pc-rel', dest="pc_rel", action="store_true", help="Allow pc-relative addressing (default: false)")
parser.add_argument('--no-long-calls', dest="no_long_calls", action="store_true", help="Do not use long calls (default: false)")
parser.add_argument("-O", dest="opt_level", default="s", help="Optimization level: 0, s (default), 2, 3, z (like GCC -O flags)")
parser.add_argument("--stop-after-compile", dest="stop_after_compile", action="store_true", help="Stop after compiling")
parser.add_argument("--stop-after-link", dest="stop_after_link", action="store_true", help="Stop after linking")
parser.add_argument("--gen-c-header", dest="gen_c_header", action="store_true", help="Generate the C header after processing (default: false)")
parser.add_argument("--header-path", dest="header_path", default=".", help="Path for the generated header (default: current dir)")
parser.add_argument("--module-name", dest="name", default=None, help="Module name (default is inferred from the name of first source)")
parser.add_argument("--build-flags", dest="build_flags", default=None)
parser.add_argument("-I", "--include-dir", dest="include_dirs", action="append",
    default=[], metavar="DIR",
    help="Add DIR to the module compile include path (repeatable). Module "
         "sources can then #include udynlink headers (e.g. "
         "udynlink_deps_api.h) without pasting macros inline. Applies to "
         "module sources only, after --build-flags.")
parser.add_argument("--public-symbols", dest="public_symbols", default=None)
parser.add_argument("--bin-name", dest="bin_name", default=None)
parser.add_argument("--mcpu", dest="mcpu", default="cortex-m4", help="Target CPU (default: cortex-m4)")
parser.add_argument("--target", dest="target", default=targets.DEFAULT_TARGET, help="Target name (default: %s)" % targets.DEFAULT_TARGET)
parser.add_argument("--mod-version", dest="mod_version", default="1.0", help="Module ABI version (default: 1.0)")
parser.add_argument("--udynlink-version", dest="udynlink_version", default="3.0", help="Loader ABI version (default: 3.0)")
parser.add_argument("--section", dest="section", action="append", default=[],
    metavar="NAME[:align=N][:flags=F1,F2]",
    help="Place tagged content into a dedicated memory region (repeatable). "
         "Module code/data tagged with UDYNLINK_SECTION(\"NAME\") or "
         "UDYNLINK_SECTION_ALIGNED(\"NAME\", N) (udynlink/udynlink_section.h) "
         "lands in section NAME, which the host resolves and allocates "
         "separately at load time. align (default 4, power of two) is the "
         "alignment the host must honor; flags is a comma list of NOCACHE, "
         "DMA, SHARED and host<N> (N in 0..7, host-private bit). Requires "
         "--udynlink-version >= 3.1 (the default becomes 3.1 when omitted); "
         "incompatible with --pc-rel and --no-long-calls.")
parser.add_argument("--no-prologue", dest="no_prologue", action="store_true", help="Skip assembly prologue generation for exported functions (default: false)")
parser.add_argument("--lto", dest="lto", action="store_true",
    help="Enable link-time optimization (GCC -flto). Compiles to fat LTO "
    "objects, splits exported functions into prologue wrappers via linker "
    "--wrap (binutils refuses symbol renames on LTO IR), and optimizes "
    "across translation units at link time. GCC-based toolchains only.")
parser.add_argument("--workdir", dest="workdir", default=None,
    help="Directory for intermediate files (*.o, *.elf, *.s) and the default .bin output (default: next to source). "
         "Also via UDYNLINK_WORKDIR env var.")
parser.add_argument("--strip-hidden-syms", dest="strip_hidden_syms",
    action="store_true",
    help="Demote defined symbols whose ELF visibility is STV_HIDDEN/STV_INTERNAL "
    "to nameless internal entries. (pair with '-fvisibility=hidden "
    "-fvisibility-inlines-hidden') in --build-flags.")
parser.add_argument("--strip-non-public-syms", dest="strip_non_public_syms",
    action="store_true",
    help="When --public-symbols is set, demote every defined symbol not in "
    "the list to nameless internal. NOP without --public-symbols.")
parser.add_argument("--strip-mangled-syms", dest="strip_mangled_syms",
    action="store_true",
    help="Demote Itanium-mangled (_Z*) defined symbols not in --public-symbols "
    "to nameless internal, and skip their prologue wrapping.")
parser.add_argument("--strip-weak-sym-names", dest="strip_weak_sym_names",
    action="store_true",
    help="Demote all defined STB_WEAK symbols not in --public-symbols to "
    "nameless internal. Loses host-override capability for those weaks.")

args, rest = parser.parse_known_args()

# Resolve target metadata
try:
    target_meta = targets.get_target(args.target)
except ValueError as e:
    error(str(e))

# --mcpu overrides target default
if not any(a.startswith("--mcpu") for a in sys.argv[1:]):
    args.mcpu = target_meta["mcpu"]

# Parse --section specs up front so malformed tags fail before any compilation
args.sections = [parse_section_spec(s) for s in args.section]
args.linker_script = None
if args.sections:
    if args.pc_rel:
        error("--pc-rel is incompatible with --section: PC-relative data addressing "
              "bakes in the link-time placement, so a tagged section could not be "
              "resolved to a different address at load time.")
    if args.no_long_calls:
        error("--no-long-calls is incompatible with --section: direct bl branches "
              "cannot cross placement sections (tagged sections resolve to unrelated "
              "addresses at load time); long calls through the LOT are placement-agnostic.")
    # The section table needs the 3.1 loader ABI; an older loader rejects the
    # image by version fence. An explicit lower version is a mistake, not a
    # downgrade — refuse it instead of silently raising.
    explicit_uv = any(a == "--udynlink-version" or a.startswith("--udynlink-version=")
                      for a in sys.argv[1:])
    if explicit_uv:
        uv_g = args.udynlink_version.split(".")
        uv_g_val = pack_version(int(uv_g[0]), int(uv_g[1] if len(uv_g) > 1 else "0"))
        if uv_g_val < pack_version(3, 1):
            error("--section requires --udynlink-version >= 3.1 (got %s): the image "
                  "carries a section table that pre-3.1 loaders cannot parse" % args.udynlink_version)

# Parse version strings (major.minor) into uint16_t (pack_version)
mv_parts = args.mod_version.split(".")
args.mod_version_val = pack_version(int(mv_parts[0]), int(mv_parts[1] if len(mv_parts) > 1 else "0"))
uv_parts = args.udynlink_version.split(".")
args.udynlink_version_val = pack_version(int(uv_parts[0]), int(uv_parts[1] if len(uv_parts) > 1 else "0"))
args.arch_tag_val = target_meta["arch_tag"]
if args.no_prologue:
    args.arch_tag_val |= ARCH_FLAG_NO_PROLOGUE
args.template = target_meta["template"]
args.fpu_flag = " -mfpu=" + target_meta["fpu"] if target_meta.get("fpu") else ""
args.float_abi_flag = " -mfloat-abi=" + target_meta["float_abi"] if target_meta.get("float_abi") else ""
if args.sections and not any(a == "--udynlink-version" or a.startswith("--udynlink-version=")
                             for a in sys.argv[1:]):
    args.udynlink_version = "3.1"
    args.udynlink_version_val = pack_version(3, 1)


# Intermediate files (objects, prologues, ELF) land in --workdir when set so the
# build tree stays clean (read-only / FetchContent'd source trees work too).
if not args.workdir:
    args.workdir = os.environ.get("UDYNLINK_WORKDIR")
if args.workdir:
    os.makedirs(args.workdir, exist_ok=True)
# No dependency list in ABI v3.0+
args.dep_list = []

if len(rest) == 0:
    error("Empty file/macro list")
# A literal '--' separator shields the source list from the caller's parser
# (argparse >= 3.13 leaves it in parse_known_args extras, so wrapper scripts
# forwarding args after '--' deliver it verbatim). One leading '--' is
# consumed; a lone '--' still trips the empty-list error below.
if rest[0] == "--":
    rest = rest[1:]
# Look in "rest" for definitions (-Dmacro or -Dmacro=value)
# The format is: first definitions, then list of files
macros = []
while len(rest) > 0 and rest[0].startswith("-D"):
    macros.append(rest[0])
    rest = rest[1:]
if len(rest) == 0:
    error("Empty file list")
# Everything past the -D block is a module source. A leftover dash-prefixed
# token is an unrecognized option — a typo, or a wrapper script leaking its
# own flags. Feeding it to gcc as an input file fails with a confusing
# "unrecognized command-line option", so name it here instead.
leaked_opts = [a for a in rest if a.startswith("-")]
if leaked_opts:
    error("unrecognized option(s) %s — every non-option argument is compiled "
          "as a module source; compiler flags belong in --build-flags"
          % " ".join(leaked_opts))
sources = rest
if args.name is None:
    _, name, _ = split_fname(sources[0])
    args.name = name

if args.bin_name is None:
    if args.workdir:
        args.bin_name = os.path.join(args.workdir, args.name + ".bin")
    else:
        path, _ = os.path.splitext(sources[0])
        args.bin_name = path + ".bin"

# The sectioned build links against a generated multi-region script instead
# of the fixed code_before_data.ld; untagged builds keep the original file,
# which is what keeps their images byte-identical.
if args.sections:
    ld_dir = args.workdir if args.workdir else os.path.dirname(os.path.abspath(sources[0]))
    args.linker_script = os.path.join(ld_dir, args.name + ".sections.ld")
    generate_sectioned_linker_script(args.linker_script, args)


public_symbols = {}
if args.public_symbols is not None:
    public_symbols = set(args.public_symbols.split(","))
assign_object_paths(sources, args)
output = os.path.join(args.workdir, (args.name if args.name else split_fname(sources[0])[1]) + ".elf") if args.workdir else change_ext(sources[0], '.elf')
objects = []
for s in sources:
    objects.extend(compile(s, args, public_symbols, macros=macros))
if args.stop_after_compile:
    sys.exit(0)
link(objects, output, args)
if args.stop_after_link:
    disasm(output, args)
    sys.exit(0)
bin_name = process(output, args)
if args.gen_c_header:
    gen_c_header(bin_name, args.header_path, args)
disasm(output, args)
